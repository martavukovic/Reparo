@page "/"
@rendermode RenderMode.InteractiveServer
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject CurrentUserService CurrentUser

<PageTitle>Reparo</PageTitle>

<MudText Typo="Typo.h4" Align="Align.Center" Class="mt-8 mb-2" Style="font-weight: 700;">
    Reparo
</MudText>
<MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6"
         Style="color: var(--mud-palette-text-secondary);">
    Sign in to continue
</MudText>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-6">

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">
                    @errorMessage
                </MudAlert>
            }

            <MudTextField @bind-Value="model.Email"
                          Label="Email"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Class="mb-3" />

            <MudTextField @bind-Value="model.Password"
                          Label="Password"
                          Variant="Variant.Outlined"
                          InputType="@(showPassword? InputType.Text: InputType.Password)"
                          Class="mb-4"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(showPassword
                                                                    ? Icons.Material.Filled.VisibilityOff
                                                                : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => showPassword = !showPassword)" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="isLoading"
                       OnClick="HandleLogin">
                @(isLoading ? "Signing in..." : "Sign In")
            </MudButton>
        </MudPaper>

        <MudPaper Class="pa-4 mt-4">
            <MudText Typo="Typo.subtitle2" Class="mb-3">Demo accounts:</MudText>

            <MudText Typo="Typo.caption" Class="mb-1"
                     Style="color: var(--mud-palette-text-secondary);">
                ADMIN
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                admin@reparo.local / Admin123!
            </MudText>

            <MudText Typo="Typo.caption" Class="mb-1"
                     Style="color: var(--mud-palette-text-secondary);">
                MANAGER
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                manager@reparo.local / Manager123!
            </MudText>

            <MudText Typo="Typo.caption" Class="mb-1"
                     Style="color: var(--mud-palette-text-secondary);">
                TECHNICIANS
            </MudText>
            <MudText Typo="Typo.body2">
                marko@reparo.local / Marko123! (Central School)
            </MudText>
            <MudText Typo="Typo.body2">
                maja@reparo.local / Maja123! (Central School)
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                petra@reparo.local / Petra123! (General Hospital)
            </MudText>

            <MudText Typo="Typo.caption" Class="mb-1"
                     Style="color: var(--mud-palette-text-secondary);">
                REPORTERS
            </MudText>
            <MudText Typo="Typo.body2">
                ana@reparo.local / Ana123! (County Hall)
            </MudText>
            <MudText Typo="Typo.body2">
                ivan@reparo.local / Ivan123! (Main Warehouse)
            </MudText>
            <MudText Typo="Typo.body2">
                luka@reparo.local / Luka123! (Central School)
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private LoginRequestDto model = new();
    private string? errorMessage;
    private bool isLoading;
    private bool showPassword = false;

    protected override void OnInitialized()
    {
        if (CurrentUser.IsLoggedIn)
            Navigation.NavigateTo("/home");
    }

    private async Task HandleLogin()
    {
        errorMessage = null;
        isLoading = true;

        var success = await AuthService.LoginAsync(model);

        if (success)
            Navigation.NavigateTo("/home");
        else
            errorMessage = "Invalid email or password.";

        isLoading = false;
    }
}