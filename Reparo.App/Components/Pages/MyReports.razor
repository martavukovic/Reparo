@page "/my-reports"
@inject NavigationManager Navigation
@using Reparo.Shared.DTOs
@inject HttpClient Http
@inject CurrentUserService CurrentUser

<PageTitle>My Reports - Reparo</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">My Reports</MudText>


@if (!CurrentUser.HasAnyRole("Reporter", "Admin"))
{
    <MudAlert Severity="Severity.Warning">Access denied.</MudAlert>
}
else
{
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Class="mb-4"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => Navigation.NavigateTo("/fault-reports/create"))">
        New Report
    </MudButton>

    }

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (reports.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No reports found.</MudAlert>
    }
    else
    {
        <MudTable Items="@reports" Hover="true" Striped="true" Dense="true">
            <HeaderContent>
                <MudTh>Title</MudTh>
                <MudTh>Location</MudTh>
                <MudTh>Priority</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Assigned To</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Deadline</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Title</MudTd>
                <MudTd>@context.LocationName</MudTd>
                <MudTd>@(context.FaultPriorityName ?? "-")</MudTd>
                <MudTd>
                    <MudChip T="string"
                             Color="@GetStatusColor(context.FaultStatusName)"
                             Size="Size.Small">
                        @context.FaultStatusName
                    </MudChip>
                </MudTd>
                <MudTd>@(context.ActiveTechnicianName ?? "Unassigned")</MudTd>
                <MudTd>@context.CreatedAt.ToString("dd.MM.yyyy")</MudTd>
                <MudTd>@(context.Deadline?.ToString("dd.MM.yyyy") ?? "-")</MudTd>
            </RowTemplate>
        </MudTable>
    }

@code {
    private List<FaultReportDto> reports = new();
    private FaultReportCreateDto form = new();
    private IBrowserFile? selectedFile;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showForm = false;
    private string reporterLocationName = string.Empty;
    private string? message;
    private Severity messageSeverity = Severity.Success;
    private int reporterLocationId = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        Console.WriteLine($"EmployeeId: {CurrentUser.User?.EmployeeId}");
        isLoading = true;
        try
        {
            if (CurrentUser.User?.EmployeeId is not null)
            {
                try
                {
                    var emp = await Http.GetFromJsonAsync<EmployeeDto>(
                        $"api/employees/{CurrentUser.User.EmployeeId}");

                    if (emp is not null)
                    {
                        reporterLocationId = emp.LocationId;
                        reporterLocationName = emp.LocationName;
                    }
                }
                catch { }
            }

            try
            {
                reports = await Http.GetFromJsonAsync<List<FaultReportDto>>(
                    "api/faultreports/mine") ?? new();
            }
            catch { }
        }
        catch { }
        finally { isLoading = false; }
    }

    private void OpenCreateForm()
    {
        Console.WriteLine($"EmployeeId: {CurrentUser.User?.EmployeeId}");
        Console.WriteLine($"LocationId: {reporterLocationId}");
        Console.WriteLine($"LocationName: {reporterLocationName}");
    
        form = new FaultReportCreateDto
        {
            LocationId = reporterLocationId,
            ReportedByEmployeeId = CurrentUser.User?.EmployeeId ?? 0
        };
        selectedFile = null;
        message = null;
        showForm = true;
        form = new FaultReportCreateDto
        {
            LocationId = reporterLocationId,
            ReportedByEmployeeId = CurrentUser.User?.EmployeeId ?? 0
        };
        selectedFile = null;
        message = null;
        showForm = true;
    }

    private int GetReporterLocationId()
    {
        return form.LocationId;
    }

    private async Task SaveReport()
    {
        if (string.IsNullOrWhiteSpace(form.Title))
        {
            message = "Title is required.";
            messageSeverity = Severity.Error;
            return;
        }

        if (form.LocationId == 0)
        {
            message = "Location not set. Please contact admin.";
            messageSeverity = Severity.Error;
            return;
        }

        if (form.ReportedByEmployeeId == 0)
        {
            message = "Your account is not linked to an employee.";
            messageSeverity = Severity.Error;
            return;
        }

        isSaving = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/faultreports", form);

            if (response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<FaultReportDto>();

                if (selectedFile is not null && created?.Id is not null)
                {
                    using var content = new MultipartFormDataContent();
                    var fileContent = new StreamContent(
                        selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
                    fileContent.Headers.ContentType =
                        new System.Net.Http.Headers.MediaTypeHeaderValue(
                            selectedFile.ContentType);

                    content.Add(new StringContent(created.Id.ToString()), "faultReportId");
                    content.Add(new StringContent("Photo Before Work"), "purpose");
                    content.Add(fileContent, "file", selectedFile.Name);

                    await Http.PostAsync("api/attachments", content);
                }

                showForm = false;
                selectedFile = null;
                message = null;
                await LoadData();
            }
            else
            {
                message = $"Error: {await response.Content.ReadAsStringAsync()}";
                messageSeverity = Severity.Error;
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            messageSeverity = Severity.Error;
        }
        finally
        {
            isSaving = false;
        }
    }

    private Color GetStatusColor(string? status) => status switch
    {
        "Closed" => Color.Success,
        "Resolved" => Color.Info,
        "In Progress" => Color.Warning,
        _ => Color.Default
    };

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }
}