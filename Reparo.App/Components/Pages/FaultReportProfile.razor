@page "/fault-reports/{Id:int}"
@inject HttpClient Http
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>Fault Report - Reparo</PageTitle>

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (report is null)
{
    <MudAlert Severity="Severity.Error">Report not found.</MudAlert>
}
else
{
    <MudButton Variant="Variant.Text"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="@(() => Navigation.NavigateTo("/fault-reports"))"
               Class="mb-4">
        Back
    </MudButton>

    <MudGrid>
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4 mb-4">
                <MudText Typo="Typo.h5" Class="mb-2">@report.Title</MudText>
                <MudText Typo="Typo.body1" Class="mb-4">@report.Description</MudText>

                <MudDivider Class="mb-3" />

                <MudGrid>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Location</MudText>
                        <MudText Typo="Typo.body2">@report.LocationName</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Reported By</MudText>
                        <MudText Typo="Typo.body2">@report.ReportedByEmployeeName</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Fault Type</MudText>
                        <MudText Typo="Typo.body2">@(report.FaultTypeName ?? "-")</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Priority</MudText>
                        <MudChip T="string"
                                 Color="@GetPriorityColor(report.FaultPriorityName)"
                                 Size="Size.Small">
                            @(report.FaultPriorityName ?? "-")
                        </MudChip>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Status</MudText>
                        <MudChip T="string"
                                 Color="@GetStatusColor(report.FaultStatusName)"
                                 Size="Size.Small">
                            @report.FaultStatusName
                        </MudChip>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Deadline</MudText>
                        <MudText Typo="Typo.body2">
                            @(report.Deadline?.ToString("dd.MM.yyyy") ?? "-")
                        </MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Assigned To</MudText>
                        <MudText Typo="Typo.body2">
                            @(report.ActiveTechnicianName ?? "Unassigned")
                        </MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Created</MudText>
                        <MudText Typo="Typo.body2">
                            @report.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        </MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <AttachmentUpload FaultReportId="@Id"
                              Attachments="@attachments"
                              OnAttachmentChanged="ReloadAttachments" />

            @if (CurrentUser.HasAnyRole("Admin", "Manager") && assignmentHistory.Any())
            {
                <MudPaper Class="pa-4 mb-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Assignment History</MudText>

                    @foreach (var assignment in assignmentHistory)
                    {
                        <MudPaper Class="pa-3 mb-3"
                                  Outlined="true"
                                  Style="@(assignment.IsActive
                                                                            ? "border-color: #7c4dff;"
                                                                            : "opacity: 0.7;")">
                            <MudGrid>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.subtitle2">
                                        @assignment.TechnicianName
                                        @if (assignment.IsActive)
                                        {
                                            <MudChip T="string"
                                                     Color="Color.Success"
                                                     Size="Size.Small"
                                                     Class="ml-2">
                                                Active
                                            </MudChip>
                                        }
                                    </MudText>
                                    <MudText Typo="Typo.caption">
                                        Assigned: @assignment.AssignedAt.ToString("dd.MM.yyyy HH:mm")
                                        by @assignment.AssignedByName
                                    </MudText>
                                    @if (!string.IsNullOrWhiteSpace(assignment.Note))
                                    {
                                        <MudText Typo="Typo.body2">Note: @assignment.Note</MudText>
                                    }
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.caption">
                                        Interventions: @assignment.Interventions.Count
                                    </MudText>
                                    @foreach (var intervention in assignment.Interventions)
                                    {
                                        <MudPaper Class="pa-2 mt-1" Outlined="true">
                                            <MudChip T="string"
                                                     Color="@GetInterventionStatusColor(
                                                                                                                                      intervention.InterventionStatusName)"
                                                     Size="Size.Small">
                                                @intervention.InterventionStatusName
                                            </MudChip>
                                            @if (intervention.StartedAt.HasValue)
                                            {
                                                <MudText Typo="Typo.caption" Class="d-block">
                                                    @intervention.StartedAt.Value.ToString("dd.MM.yyyy HH:mm")
                                                    —
                                                    @(intervention.FinishedAt?.ToString("dd.MM.yyyy HH:mm") ?? "ongoing")
                                                </MudText>
                                            }
                                            @if (intervention.DurationMinutes.HasValue)
                                            {
                                                <MudText Typo="Typo.caption">
                                                    Duration: @intervention.DurationMinutes min
                                                </MudText>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(intervention.Note) &&
                                                                                 intervention.Note != "-")
                                            {
                                                <MudText Typo="Typo.caption">
                                                    @intervention.Note
                                                </MudText>
                                            }
                                            @if (intervention.Materials.Any())
                                            {
                                                <MudText Typo="Typo.caption" Class="mt-1">
                                                    Materials:
                                                    @string.Join(", ", intervention.Materials.Select(
                                                        m => $"{m.MaterialName} {m.Quantity} {m.MaterialUnitName}"))
                                                </MudText>
                                            }
                                        </MudPaper>
                                    }
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </MudPaper>
            }
        </MudItem>

        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">Timeline</MudText>
            <FaultReportTimeline FaultReportId="@Id" />
        </MudPaper>

        @if (CurrentUser.HasAnyRole("Admin", "Manager"))
        {
            <MudItem xs="12" md="4">
                @if (CurrentUser.HasAnyRole("Admin", "Manager"))
                {
                    <MudPaper Class="pa-4 mb-4">
                        <MudText Typo="Typo.h6" Class="mb-3">🤖 AI Summary</MudText>
                        @if (aiSummary is not null)
                        {
                            <MudText Typo="Typo.body2" Class="mb-2">@aiSummary</MudText>
                        }
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Disabled="isLoadingSummary"
                                   OnClick="GetAiSummary">
                            @(isLoadingSummary ? "Generating..." : "Generate Summary")
                        </MudButton>
                    </MudPaper>
                }
                <MudPaper Class="pa-4 mb-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Review Report</MudText>

                    <MudSelect T="int?"
                               @bind-Value="reviewForm.FaultTypeId"
                               Label="Fault Type"
                               Variant="Variant.Outlined"
                               Class="mb-3"
                               Clearable="true">
                        @foreach (var t in faultTypes)
                        {
                            <MudSelectItem T="int?" Value="@((int?)t.Id)">@t.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="int?"
                               @bind-Value="reviewForm.FaultPriorityId"
                               Label="Priority"
                               Variant="Variant.Outlined"
                               Class="mb-3"
                               Clearable="true">
                        @foreach (var p in priorities)
                        {
                            <MudSelectItem T="int?" Value="@((int?)p.Id)">@p.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudDatePicker @bind-Date="deadline"
                                   Label="Deadline"
                                   Variant="Variant.Outlined"
                                   Class="mb-3" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               OnClick="SaveReview"
                               Class="mb-3">
                        Save Review
                    </MudButton>

                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <MudAlert Severity="@messageSeverity" Class="mb-3">
                            @message
                        </MudAlert>
                    }
                </MudPaper>

                @if (report.FaultStatusName != "Resolved" &&
                                     report.FaultStatusName != "Closed")
                {
                    <MudPaper Class="pa-4 mb-4">
                        <MudText Typo="Typo.h6" Class="mb-3">Assign Technician</MudText>

                        <MudSelect T="int"
                                   @bind-Value="assignTechnicianId"
                                   Label="Technician"
                                   Variant="Variant.Outlined"
                                   Class="mb-3">
                            @foreach (var t in technicians)
                            {
                                <MudSelectItem T="int" Value="@t.Id">@t.Name</MudSelectItem>
                            }
                        </MudSelect>

                        <MudTextField @bind-Value="assignNote"
                                      Label="Note"
                                      Variant="Variant.Outlined"
                                      Class="mb-3" />

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   FullWidth="true"
                                   OnClick="AssignTechnician">
                            Assign
                        </MudButton>
                    </MudPaper>
                }

                @if (report.FaultStatusName == "Resolved")
                {
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-3">Close Report</MudText>
                        <MudText Typo="Typo.body2" Class="mb-3">
                            Intervention has been completed successfully.
                            You can now close this report.
                        </MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   FullWidth="true"
                                   OnClick="CloseReport">
                            Close Report
                        </MudButton>
                    </MudPaper>
                }
            </MudItem>
        }
    </MudGrid>
}

@code {
    [Parameter] public int Id { get; set; }

    private FaultReportDto? report;
    private List<AttachmentDto> attachments = new();
    private List<LookupDto> faultTypes = new();
    private List<LookupDto> priorities = new();
    private List<LookupDto> technicians = new();
    private FaultReportUpdateDto reviewForm = new();
    private DateTime? deadline;
    private int assignTechnicianId;
    private string assignNote = "";
    private bool isLoading = true;
    private string? message;
    private Severity messageSeverity = Severity.Success;
    private List<WorkAssignmentDto> assignmentHistory = new();
    private string? aiSummary;
    private bool isLoadingSummary = false;

    private async Task GetAiSummary()
    {
        isLoadingSummary = true;
        try
        {
            var response = await Http.GetAsync($"api/ai/summarize/{Id}");
            if (response.IsSuccessStatusCode)
                aiSummary = await response.Content.ReadAsStringAsync();
        }
        catch { }
        finally { isLoadingSummary = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var t1 = Http.GetFromJsonAsync<FaultReportDto>($"api/faultreports/{Id}");
            var t2 = Http.GetFromJsonAsync<List<AttachmentDto>>(
                $"api/attachments/fault-report/{Id}");
            var t3 = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/fault-types");
            var t4 = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/fault-priorities");
            var t5 = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/technicians");

            await Task.WhenAll(t1, t2, t3, t4, t5);

            report = t1.Result;
            attachments = t2.Result ?? new();
            faultTypes = t3.Result ?? new();
            priorities = t4.Result ?? new();
            technicians = t5.Result ?? new();

            if (report is not null)
            {
                reviewForm.FaultTypeId = report.FaultTypeId;
                reviewForm.FaultPriorityId = report.FaultPriorityId;
                deadline = report.Deadline;
            }

            if (CurrentUser.HasAnyRole("Admin", "Manager"))
            {
                try
                {
                    assignmentHistory = await Http.GetFromJsonAsync<List<WorkAssignmentDto>>(
                        $"api/workassignments/fault-report/{Id}") ?? new();
                }
                catch { }
            }
        }
        catch { }
        finally { isLoading = false; }
    }

    private async Task ReloadAttachments()
    {
        attachments = await Http.GetFromJsonAsync<List<AttachmentDto>>(
            $"api/attachments/fault-report/{Id}") ?? new();
    }

    private Color GetInterventionStatusColor(string? status) => status switch
    {
        "Completed" => Color.Success,
        "Failed" => Color.Error,
        "In Progress" => Color.Warning,
        _ => Color.Default
    };

    private async Task SaveReview()
    {
        try
        {
            reviewForm.Deadline = deadline;
            var response = await Http.PutAsJsonAsync(
                $"api/faultreports/{Id}/review", reviewForm);

            if (response.IsSuccessStatusCode)
            {
                message = "Report reviewed successfully.";
                messageSeverity = Severity.Success;
                await LoadData();
            }
            else
            {
                message = await response.Content.ReadAsStringAsync();
                messageSeverity = Severity.Error;
            }
        }
        catch { }
    }

    private async Task AssignTechnician()
    {
        try
        {
            var dto = new WorkAssignmentCreateDto
            {
                FaultReportId = Id,
                TechnicianId = assignTechnicianId,
                Note = assignNote
            };

            var response = await Http.PostAsJsonAsync("api/workassignments", dto);

            if (response.IsSuccessStatusCode)
            {
                message = "Technician assigned successfully.";
                messageSeverity = Severity.Success;
                await LoadData();
            }
            else
            {
                message = await response.Content.ReadAsStringAsync();
                messageSeverity = Severity.Error;
            }
        }
        catch { }
    }

    private async Task CloseReport()
    {
        try
        {
            var response = await Http.PutAsJsonAsync(
                $"api/faultreports/{Id}/close", new { });

            if (response.IsSuccessStatusCode)
            {
                message = "Report closed successfully.";
                messageSeverity = Severity.Success;
                await LoadData();
            }
            else
            {
                message = await response.Content.ReadAsStringAsync();
                messageSeverity = Severity.Error;
            }
        }
        catch { }
    }

    private Color GetPriorityColor(string? priority) => priority switch
    {
        "Critical" => Color.Error,
        "High" => Color.Warning,
        "Medium" => Color.Info,
        _ => Color.Default
    };

    private Color GetStatusColor(string? status) => status switch
    {
        "Closed" => Color.Success,
        "Resolved" => Color.Info,
        "In Progress" => Color.Warning,
        _ => Color.Default
    };
}