@page "/fault-reports/create"
@page "/fault-reports/edit/{Id:int}"
@inject HttpClient Http
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>@(Id == 0 ? "New Fault Report" : "Edit Fault Report") - Reparo</PageTitle>

<MudButton Variant="Variant.Text"
           StartIcon="@Icons.Material.Filled.ArrowBack"
           OnClick="@(() => Navigation.NavigateTo(
                                             CurrentUser.HasAnyRole("Admin", "Manager")
                                                 ? "/fault-reports"
                                                 : "/my-reports"))"
           Class="mb-4">
    Back
</MudButton>

@* Naslov je manji na mobitelu (MudHidden umjesto media querya) *@
<MudHidden Breakpoint="Breakpoint.SmAndDown">
    <MudText Typo="Typo.h4" Class="mb-4">
        @(Id == 0 ? "New Fault Report" : "Edit Fault Report")
    </MudText>
</MudHidden>
<MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
    <MudText Typo="Typo.h5" Class="mb-4">
        @(Id == 0 ? "New Fault Report" : "Edit Fault Report")
    </MudText>
</MudHidden>

@if (!CurrentUser.HasAnyRole("Admin", "Manager", "Reporter"))
{
    <MudAlert Severity="Severity.Warning">Access denied.</MudAlert>
}
else if (isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid>
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-3 pa-sm-4">

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <MudAlert Severity="@messageSeverity" Class="mb-4"
                              ShowCloseIcon="true"
                              CloseIconClicked="@(() => message = null)">
                        @message
                    </MudAlert>
                }

                <MudGrid>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="form.Title"
                                      Label="Title"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      HelperText="Brief description of the fault" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="form.Description"
                                      Label="Description"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Lines="4"
                                      HelperText="Provide as much detail as possible" />
                    </MudItem>

                    @if (CurrentUser.HasAnyRole("Admin", "Manager"))
                    {
                        <MudItem xs="12" sm="6">
                            <MudSelect T="int"
                                       @bind-Value="form.LocationId"
                                       Label="Location"
                                       Variant="Variant.Outlined"
                                       FullWidth="true">
                                <MudSelectItem T="int" Value="0" Disabled="true">
                                    Select location...
                                </MudSelectItem>
                                @foreach (var l in locations)
                                {
                                    <MudSelectItem T="int" Value="@l.Id">@l.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="int"
                                       @bind-Value="form.ReportedByEmployeeId"
                                       Label="Reported By"
                                       Variant="Variant.Outlined"
                                       FullWidth="true">
                                <MudSelectItem T="int" Value="0" Disabled="true">
                                    Select reporter...
                                </MudSelectItem>
                                @foreach (var e in employees)
                                {
                                    <MudSelectItem T="int" Value="@e.Id">@e.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption"
                                     Style="color: var(--mud-palette-text-secondary);">
                                Location
                            </MudText>
                            <MudText Typo="Typo.body1" Style="font-weight: 500;">
                                @reporterLocationName
                            </MudText>
                        </MudItem>
                    }

                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            Photo Before Work (optional)
                        </MudText>

                        @* Desktop: sve u jednom redu *@
                        <MudHidden Breakpoint="Breakpoint.SmAndDown">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <InputFile id="photoInputDesktop"
                                           OnChange="HandleFileSelected"
                                           accept="image/jpeg,image/png,image/webp"
                                           style="display:none;" />
                                <MudButton Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.AddAPhoto"
                                           Size="Size.Small">
                                    <label for="photoInputDesktop" style="cursor:pointer; margin:0;">
                                        Choose Photo
                                    </label>
                                </MudButton>
                                @if (selectedFile is not null)
                                {
                                    <MudText Typo="Typo.body2">
                                        @selectedFile.Name
                                        (@($"{selectedFile.Size / 1024:N0} KB"))
                                    </MudText>
                                    <MudButton Variant="Variant.Text"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => selectedFile = null)">
                                        Remove
                                    </MudButton>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2"
                                             Style="color: var(--mud-palette-text-secondary);">
                                        No file selected
                                    </MudText>
                                }
                            </MudStack>
                        </MudHidden>

                        @* Mobitel: puna širina, jedno ispod drugog *@
                        <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
                            <MudStack Row="false" Spacing="2">
                                <InputFile id="photoInputMobile"
                                           OnChange="HandleFileSelected"
                                           accept="image/jpeg,image/png,image/webp"
                                           style="display:none;" />
                                <MudButton Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.AddAPhoto"
                                           FullWidth="true">
                                    <label for="photoInputMobile" style="cursor:pointer; margin:0;">
                                        Choose Photo
                                    </label>
                                </MudButton>
                                @if (selectedFile is not null)
                                {
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudText Typo="Typo.body2">
                                            @selectedFile.Name
                                            (@($"{selectedFile.Size / 1024:N0} KB"))
                                        </MudText>
                                        <MudButton Variant="Variant.Text"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => selectedFile = null)">
                                            Remove
                                        </MudButton>
                                    </MudStack>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2"
                                             Style="color: var(--mud-palette-text-secondary);">
                                        No file selected
                                    </MudText>
                                }
                            </MudStack>
                        </MudHidden>
                    </MudItem>
                </MudGrid>

                @* Desktop: gumbi jedan pored drugog *@
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudStack Row="true" Class="mt-4" Spacing="3">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="isSaving"
                                   OnClick="Save">
                            @(isSaving ? "Saving..." : (Id == 0 ? "Submit Report" : "Save Changes"))
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   OnClick="@(() => Navigation.NavigateTo(
                                                                                                                   CurrentUser.HasAnyRole("Admin", "Manager")
                                                                                                                       ? "/fault-reports"
                                                                                                                       : "/my-reports"))">
                            Cancel
                        </MudButton>
                    </MudStack>
                </MudHidden>

                @* Mobitel: gumbi puna širina, jedan iznad drugog *@
                <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
                    <MudStack Row="false" Class="mt-4" Spacing="2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="isSaving"
                                   FullWidth="true"
                                   Class="py-3"
                                   Style="text-transform:none; font-size:1rem;"
                                   OnClick="Save">
                            @(isSaving ? "Saving..." : (Id == 0 ? "Submit Report" : "Save Changes"))
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   FullWidth="true"
                                   Class="py-3"
                                   Style="text-transform:none; font-size:1rem;"
                                   OnClick="@(() => Navigation.NavigateTo(
                                                                                   CurrentUser.HasAnyRole("Admin", "Manager")
                                                                                       ? "/fault-reports"
                                                                                       : "/my-reports"))">
                            Cancel
                        </MudButton>
                    </MudStack>
                </MudHidden>
            </MudPaper>
        </MudItem>

        @* Tips sekcija - sakrivena na mobitelu (xs, sm), vidljiva od md nadalje *@
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4 mb-4">
                    <MudText Typo="Typo.subtitle2" Class="mb-3">💡 Tips</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        • Be specific in the title to help technicians understand the issue
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        • Add a photo to help the technician understand the issue
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudHidden>
    </MudGrid>

}

@code {
    [Parameter] public int Id { get; set; } = 0;

    private FaultReportCreateDto form = new();
    private List<LookupDto> locations = new();
    private List<LookupDto> employees = new();
    private List<LookupDto> faultTypes = new();
    private IBrowserFile? selectedFile;
    private System.Timers.Timer? _debounceTimer;
    private bool isLoading = true;
    private bool isSaving = false;
    private string? message;
    private Severity messageSeverity = Severity.Success;
    private string reporterLocationName = string.Empty;
    private int reporterLocationId = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();

        if (Id != 0)
            await LoadExisting();

        isLoading = false;
    }

    private async Task LoadLookups()
    {
        try
        {
            if (CurrentUser.HasAnyRole("Admin", "Manager"))
            {
                var t1 = Http.GetFromJsonAsync<List<LookupDto>>("api/locations/lookup");
                var t2 = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/employees");
                var t3 = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/fault-types");

                await Task.WhenAll(t1, t2, t3);

                locations = t1.Result ?? new();
                employees = t2.Result ?? new();
                faultTypes = t3.Result ?? new();
            }
            else
            {
                // Reporter — učitaj samo svoju lokaciju
                faultTypes = await Http.GetFromJsonAsync<List<LookupDto>>(
                    "api/lookups/fault-types") ?? new();

                if (CurrentUser.User?.EmployeeId is not null)
                {
                    try
                    {
                        var emp = await Http.GetFromJsonAsync<EmployeeDto>(
                            $"api/employees/{CurrentUser.User.EmployeeId}");

                        if (emp is not null)
                        {
                            reporterLocationId = emp.LocationId;
                            reporterLocationName = emp.LocationName;
                            form.LocationId = emp.LocationId;
                            form.ReportedByEmployeeId = CurrentUser.User.EmployeeId.Value;
                        }
                    }
                    catch { }
                }
            }
        }
        catch { }
    }

    private async Task LoadExisting()
    {
        try
        {
            var report = await Http.GetFromJsonAsync<FaultReportDto>(
                $"api/faultreports/{Id}");

            if (report is not null)
            {
                form.Title = report.Title;
                form.Description = report.Description;
                form.LocationId = report.LocationId;
                form.ReportedByEmployeeId = report.ReportedByEmployeeId;
            }
        }
        catch { }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(form.Title))
        {
            message = "Title is required.";
            messageSeverity = Severity.Error;
            return;
        }

        if (form.LocationId == 0)
        {
            message = "Please select a location.";
            messageSeverity = Severity.Error;
            return;
        }

        if (form.ReportedByEmployeeId == 0)
        {
            message = "Reporter is required.";
            messageSeverity = Severity.Error;
            return;
        }

        isSaving = true;

        try
        {
            HttpResponseMessage response;

            if (Id == 0)
                response = await Http.PostAsJsonAsync("api/faultreports", form);
            else
                response = await Http.PutAsJsonAsync(
                    $"api/faultreports/{Id}/edit", form);

            if (response.IsSuccessStatusCode)
            {
                var created = Id == 0
                    ? await response.Content.ReadFromJsonAsync<FaultReportDto>()
                    : null;

                if (selectedFile is not null)
                {
                    var reportId = Id == 0 ? created?.Id ?? 0 : Id;
                    if (reportId > 0)
                    {
                        using var content = new MultipartFormDataContent();
                        var fileContent = new StreamContent(
                            selectedFile.OpenReadStream(
                                maxAllowedSize: 10 * 1024 * 1024));
                        fileContent.Headers.ContentType =
                            new System.Net.Http.Headers.MediaTypeHeaderValue(
                                selectedFile.ContentType);

                        content.Add(new StringContent(reportId.ToString()),
                            "faultReportId");
                        content.Add(new StringContent("Photo Before Work"), "purpose");
                        content.Add(fileContent, "file", selectedFile.Name);

                        await Http.PostAsync("api/attachments", content);
                    }
                }

                if (CurrentUser.HasAnyRole("Admin", "Manager"))
                    Navigation.NavigateTo(Id == 0
                        ? $"/fault-reports/{created?.Id ?? 0}"
                        : $"/fault-reports/{Id}");
                else
                    Navigation.NavigateTo("/my-reports");
            }
            else
            {
                message = $"Error: {await response.Content.ReadAsStringAsync()}";
                messageSeverity = Severity.Error;
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            messageSeverity = Severity.Error;
        }
        finally
        {
            isSaving = false;
        }
    }

    private Color GetPriorityColor(string? priority) => priority switch
    {
        "Critical" => Color.Error,
        "High" => Color.Warning,
        "Medium" => Color.Info,
        _ => Color.Default
    };
}