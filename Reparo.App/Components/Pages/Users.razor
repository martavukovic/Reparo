@page "/users"
@inject HttpClient Http
@inject CurrentUserService CurrentUser

<PageTitle>Users - Reparo</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Users</MudText>
    <MudSpacer />
    @if (!showAddForm)
    {
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="@(() => showAddForm = true)">
            Add User
        </MudButton>
    }
</MudStack>

@if (!CurrentUser.HasRole("Admin"))
{
    <MudAlert Severity="Severity.Warning">Access denied.</MudAlert>
}
else
{
    @if (showAddForm)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">New User</MudText>

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="form.FirstName"
                                  Label="First Name"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="form.LastName"
                                  Label="Last Name"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="form.Email"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="form.Password"
                                  Label="Password"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  HelperText="Minimum 6 characters" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int"
                               @bind-Value="form.LocationId"
                               Label="Location"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="int" Value="0" Disabled="true">
                            Select location...
                        </MudSelectItem>
                        @foreach (var l in locations)
                        {
                            <MudSelectItem T="int" Value="@l.Id">@l.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="form.Role"
                               Label="Role"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@("Reporter")">Reporter</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Technician")">Technician</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Manager")">Manager</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Admin")">Admin</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <MudAlert Severity="@messageSeverity" Class="mt-3">@message</MudAlert>
            }

            <MudStack Row="true" Class="mt-4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="CreateUser">
                    Create User
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           OnClick="@(() => { showAddForm = false; form = new(); message = null; })">
                    Cancel
                </MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (users.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No users found.</MudAlert>
    }
    else
    {
        <MudTable Items="@users" Hover="true" Striped="true" Dense="true">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Roles</MudTh>
                <MudTh>Employee</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.DisplayName</MudTd>
                <MudTd>@context.Email</MudTd>
                <MudTd>
                    @foreach (var role in context.Roles)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                 Class="mr-1">
                            @role
                        </MudChip>
                    }
                </MudTd>
                <MudTd>@(context.EmployeeName ?? "-")</MudTd>
                <MudTd>
                    <MudChip T="string"
                             Color="@(context.IsActive ? Color.Success : Color.Default)"
                             Size="Size.Small">
                        @(context.IsActive ? "Active" : "Inactive")
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Lock"
                                   Size="Size.Small"
                                   Title="Reset Password"
                                   OnClick="@(() => OpenPasswordReset(context.Id))" />
                    @if (context.IsActive)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.PersonOff"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       Title="Deactivate"
                                       OnClick="@(() => DeactivateUser(context.Id))" />
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    @* Password Reset Dialog *@
    @if (showPasswordDialog)
    {
        <MudDialog @bind-Visible="showPasswordDialog">
            <TitleContent>
                <MudText Typo="Typo.h6">Reset Password</MudText>
            </TitleContent>
            <DialogContent>
                <MudTextField @bind-Value="newPassword"
                              Label="New Password"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              HelperText="Minimum 6 characters" />
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="@(() => showPasswordDialog = false)">Cancel</MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="ResetPassword">
                    Reset
                </MudButton>
            </DialogActions>
        </MudDialog>
    }

    @if (!string.IsNullOrWhiteSpace(message) && !showAddForm)
    {
        <MudAlert Severity="@messageSeverity" Class="mt-4"
                  ShowCloseIcon="true"
                  CloseIconClicked="@(() => message = null)">
            @message
        </MudAlert>
    }
}

@code {
    private List<UserDto> users = new();
    private List<LookupDto> locations = new();
    private bool isLoading = true;
    private bool showAddForm = false;
    private bool showPasswordDialog = false;
    private string? resetPasswordUserId;
    private string newPassword = string.Empty;
    private string? message;
    private Severity messageSeverity = Severity.Success;

    private CreateUserDto form = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var t1 = Http.GetFromJsonAsync<List<UserDto>>("api/users");
            var t2 = Http.GetFromJsonAsync<List<LookupDto>>("api/locations/lookup");

            await Task.WhenAll(t1, t2);

            users = t1.Result ?? new();
            locations = t2.Result ?? new();
        }
        catch { }
        finally { isLoading = false; }
    }

    private async Task CreateUser()
    {
        if (string.IsNullOrWhiteSpace(form.FirstName) ||
            string.IsNullOrWhiteSpace(form.LastName) ||
            string.IsNullOrWhiteSpace(form.Email) ||
            string.IsNullOrWhiteSpace(form.Password) ||
            form.LocationId == 0 ||
            string.IsNullOrWhiteSpace(form.Role))
        {
            message = "All fields are required.";
            messageSeverity = Severity.Error;
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/users", form);

            if (response.IsSuccessStatusCode)
            {
                message = "User created successfully.";
                messageSeverity = Severity.Success;
                showAddForm = false;
                form = new CreateUserDto();
                await LoadData();
            }
            else
            {
                message = await response.Content.ReadAsStringAsync();
                messageSeverity = Severity.Error;
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            messageSeverity = Severity.Error;
        }
    }

    private void OpenPasswordReset(string userId)
    {
        resetPasswordUserId = userId;
        newPassword = string.Empty;
        showPasswordDialog = true;
    }

    private async Task ResetPassword()
    {
        if (string.IsNullOrWhiteSpace(newPassword) || newPassword.Length < 6)
        {
            message = "Password must be at least 6 characters.";
            messageSeverity = Severity.Error;
            return;
        }

        try
        {
            var response = await Http.PutAsJsonAsync(
                $"api/users/{resetPasswordUserId}/password", newPassword);

            if (response.IsSuccessStatusCode)
            {
                message = "Password reset successfully.";
                messageSeverity = Severity.Success;
                showPasswordDialog = false;
            }
            else
            {
                message = await response.Content.ReadAsStringAsync();
                messageSeverity = Severity.Error;
            }
        }
        catch { }
    }

    private async Task DeactivateUser(string userId)
    {
        try
        {
            var response = await Http.PutAsJsonAsync(
                $"api/users/{userId}/deactivate", new { });

            if (response.IsSuccessStatusCode)
            {
                message = "User deactivated.";
                messageSeverity = Severity.Success;
                await LoadData();
            }
            else
            {
                message = await response.Content.ReadAsStringAsync();
                messageSeverity = Severity.Error;
            }
        }
        catch { }
    }
}