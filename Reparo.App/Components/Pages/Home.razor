@page "/"
@inject HttpClient Http
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>Dashboard - Reparo</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Dashboard</MudText>

@if (!CurrentUser.IsLoggedIn)
{
    <MudAlert Severity="Severity.Info">
        Please <MudLink Href="/login">sign in</MudLink> to view the dashboard.
    </MudAlert>
}
else if (isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (dashboard is not null)
{
    @if (CurrentUser.HasAnyRole("Admin", "Manager"))
    {
        @if (CurrentUser.HasRole("Admin") && aiProvider is not null)
        {
            <MudAlert Severity="@(aiProvider.UsesExternalService? Severity.Warning: Severity.Info)"
                      Class="mb-4">
                AI Provider: <strong>@aiProvider.Provider</strong>
                @if (aiProvider.UsesExternalService)
                {
                    <span> — External service active</span>
                }
                else
                {
                    <span> — Running in Mock mode</span>
                }
            </MudAlert>
        }
        <MudText Typo="Typo.h6" Class="mb-3">Overview</MudText>
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Style="border-left: 4px solid #7c4dff;">
                    <MudText Typo="Typo.caption">Open Reports</MudText>
                    <MudText Typo="Typo.h4">@dashboard.TotalOpen</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Style="border-left: 4px solid red;">
                    <MudText Typo="Typo.caption">Critical</MudText>
                    <MudText Typo="Typo.h4" Style="color: red;">
                        @dashboard.TotalCritical
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Style="border-left: 4px solid orange;">
                    <MudText Typo="Typo.caption">Overdue</MudText>
                    <MudText Typo="Typo.h4" Style="color: orange;">
                        @dashboard.TotalOverdue
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Style="border-left: 4px solid grey;">
                    <MudText Typo="Typo.caption">Unassigned</MudText>
                    <MudText Typo="Typo.h4">@dashboard.TotalUnassigned</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Style="border-left: 4px solid #00bcd4;">
                    <MudText Typo="Typo.caption">Active Interventions</MudText>
                    <MudText Typo="Typo.h4">@dashboard.TotalActiveInterventions</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Style="border-left: 4px solid #4caf50;">
                    <MudText Typo="Typo.caption">Avg. Resolution (days)</MudText>
                    <MudText Typo="Typo.h4">@dashboard.AverageResolutionDays</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.h6" Class="mb-2">Last 5 Reports</MudText>
        <MudTable Items="@dashboard.LastFiveReports"
                  Hover="true" Striped="true" Dense="true"
                  Class="mb-4">
            <HeaderContent>
                <MudTh>Title</MudTh>
                <MudTh>Location</MudTh>
                <MudTh>Priority</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Created</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Title</MudTd>
                <MudTd>@context.LocationName</MudTd>
                <MudTd>
                    <MudChip T="string"
                             Color="@GetPriorityColor(context.FaultPriorityName)"
                             Size="Size.Small">
                        @(context.FaultPriorityName ?? "-")
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudChip T="string"
                             Color="@GetStatusColor(context.FaultStatusName)"
                             Size="Size.Small">
                        @context.FaultStatusName
                    </MudChip>
                </MudTd>
                <MudTd>@context.CreatedAt.ToString("dd.MM.yyyy")</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Size="Size.Small"
                                   OnClick="@(() => Navigation.NavigateTo(
                                                                                              $"/fault-reports/{context.Id}"))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    @if (CurrentUser.HasRole("Reporter"))
    {
        <MudText Typo="Typo.h6" Class="mb-3">My Activity</MudText>
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6">
                <MudPaper Class="pa-4" Style="border-left: 4px solid #7c4dff;">
                    <MudText Typo="Typo.caption">My Total Reports</MudText>
                    <MudText Typo="Typo.h4">@dashboard.MyReportsCount</MudText>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               OnClick="@(() => Navigation.NavigateTo("/my-reports"))">
                        View My Reports →
                    </MudButton>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Class="pa-4" Style="border-left: 4px solid #4caf50;">
                    <MudText Typo="Typo.caption">Open Reports</MudText>
                    <MudText Typo="Typo.h4">@dashboard.TotalOpen</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @if (dashboard.LastFiveReports.Any())
        {
            <MudText Typo="Typo.h6" Class="mb-2">My Recent Reports</MudText>
            <MudTable Items="@dashboard.LastFiveReports"
                      Hover="true" Striped="true" Dense="true"
                      Class="mb-4">
                <HeaderContent>
                    <MudTh>Title</MudTh>
                    <MudTh>Location</MudTh>
                    <MudTh>Priority</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Assigned To</MudTh>
                    <MudTh>Created</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Title</MudTd>
                    <MudTd>@context.LocationName</MudTd>
                    <MudTd>
                        <MudChip T="string"
                                 Color="@GetPriorityColor(context.FaultPriorityName)"
                                 Size="Size.Small">
                            @(context.FaultPriorityName ?? "-")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string"
                                 Color="@GetStatusColor(context.FaultStatusName)"
                                 Size="Size.Small">
                            @context.FaultStatusName
                        </MudChip>
                    </MudTd>
                    <MudTd>@(context.ActiveTechnicianName ?? "Unassigned")</MudTd>
                    <MudTd>@context.CreatedAt.ToString("dd.MM.yyyy")</MudTd>
                </RowTemplate>
            </MudTable>
        }
    }

    @if (CurrentUser.HasRole("Technician"))
    {
        <MudText Typo="Typo.h6" Class="mb-3">My Activity</MudText>
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6">
                <MudPaper Class="pa-4" Style="border-left: 4px solid #7c4dff;">
                    <MudText Typo="Typo.caption">Active Assignments</MudText>
                    <MudText Typo="Typo.h4">@dashboard.MyAssignmentsCount</MudText>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               OnClick="@(() => Navigation.NavigateTo("/my-assignments"))">
                        View My Assignments →
                    </MudButton>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Class="pa-4" Style="border-left: 4px solid orange;">
                    <MudText Typo="Typo.caption">Active Interventions</MudText>
                    <MudText Typo="Typo.h4">@dashboard.TotalActiveInterventions</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
}

@code {
    private DashboardDto? dashboard;
    private bool isLoading = true;
    private AiProviderDto? aiProvider;

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsLoggedIn)
        {
            isLoading = false;
            return;
        }

        try
        {
            dashboard = await Http.GetFromJsonAsync<DashboardDto>("api/dashboard");
            aiProvider = await Http.GetFromJsonAsync<AiProviderDto>("api/ai/provider");
        }
        catch { }
        finally
        {
            isLoading = false;
        }
    }

    private Color GetPriorityColor(string? priority) => priority switch
    {
        "Critical" => Color.Error,
        "High" => Color.Warning,
        "Medium" => Color.Info,
        _ => Color.Default
    };

    private Color GetStatusColor(string? status) => status switch
    {
        "Closed" => Color.Success,
        "Resolved" => Color.Info,
        "In Progress" => Color.Warning,
        _ => Color.Default
    };
}