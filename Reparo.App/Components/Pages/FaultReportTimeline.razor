@inject HttpClient Http

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
}
else if (events.Count == 0)
{
    <MudText Typo="Typo.body2" Style="color: grey;">No timeline events.</MudText>
}
else
{
    <MudTimeline TimelinePosition="TimelinePosition.Left">
        @foreach (var ev in events)
        {
            <MudTimelineItem Color="@GetColor(ev.Color)"
                             Size="Size.Small">
                <ItemContent>
                    <MudPaper Class="pa-3 mb-2" Outlined="true">
                        <MudText Typo="Typo.caption" Style="color: grey;">
                            @ev.Timestamp.ToString("dd.MM.yyyy HH:mm")
                            @if (!string.IsNullOrWhiteSpace(ev.Actor) &&
                                                             ev.Actor != "System")
                            {
                                <span> — @ev.Actor</span>
                            }
                        </MudText>
                        <MudText Typo="Typo.body2">@ev.Description</MudText>
                    </MudPaper>
                </ItemContent>
            </MudTimelineItem>
        }
    </MudTimeline>
}

@code {
    [Parameter] public int FaultReportId { get; set; }

    private List<TimelineEventDto> events = new();
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        await LoadTimeline();
    }

    private async Task LoadTimeline()
    {
        isLoading = true;
        try
        {
            events = await Http.GetFromJsonAsync<List<TimelineEventDto>>(
                $"api/faultreports/{FaultReportId}/timeline") ?? new();
        }
        catch { }
        finally { isLoading = false; }
    }

    private Color GetColor(string color) => color switch
    {
        "primary" => Color.Primary,
        "secondary" => Color.Secondary,
        "success" => Color.Success,
        "error" => Color.Error,
        "warning" => Color.Warning,
        "info" => Color.Info,
        _ => Color.Default
    };
}