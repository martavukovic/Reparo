@page "/fault-reports/{Id:int}"
@inject HttpClient Http
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>Fault Report - Reparo</PageTitle>

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (report is null)
{
    <MudAlert Severity="Severity.Error">Report not found.</MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("/fault-reports"))">
            Back
        </MudButton>
        <MudSpacer />
        <MudChip T="string"
                 Color="@GetStatusColor(report.FaultStatusName)"
                 Size="Size.Medium">
            @report.FaultStatusName
        </MudChip>
        @if (report.HasFailedIntervention &&
                     report.FaultStatusName != "Resolved" &&
                     report.FaultStatusName != "Closed")
        {
            <MudChip T="string"
                     Color="Color.Error"
                     Icon="@Icons.Material.Filled.Warning"
                     Size="Size.Small">
                Failed intervention — reassignment needed
            </MudChip>
        }
    </MudStack>

    <MudGrid>
        <MudItem xs="12" md="8">

            <MudPaper Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" Class="mb-3">Report Details</MudText>
                <MudText Typo="Typo.h5" Class="mb-2">@report.Title</MudText>
                <MudText Typo="Typo.body1" Class="mb-4">@report.Description</MudText>
                <MudDivider Class="mb-3" />
                <MudGrid>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Location</MudText>
                        <MudText Typo="Typo.body2">@report.LocationName</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Reported By</MudText>
                        <MudText Typo="Typo.body2">@report.ReportedByEmployeeName</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Created</MudText>
                        <MudText Typo="Typo.body2">
                            @report.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        </MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Assigned To</MudText>
                        <MudText Typo="Typo.body2">
                            @(report.ActiveTechnicianName ?? "Unassigned")
                        </MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <PhotoComparison BeforePhotos="@BeforePhotos"
                             AfterPhotos="@AfterPhotos" />

            <AttachmentUpload FaultReportId="@Id"
                              Attachments="@attachments"
                              OnAttachmentChanged="ReloadAttachments" />

            @if (CurrentUser.HasAnyRole("Admin", "Manager") && assignmentHistory.Any())
            {
                <MudPaper Class="pa-4 mb-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Assignment History</MudText>
                    @foreach (var assignment in assignmentHistory)
                    {
                        <MudPaper Class="pa-3 mb-2"
                                  Outlined="true"
                                  Style="@(assignment.IsActive
                                                                                                    ? "border-color: var(--mud-palette-primary);"
                                                                                                    : "opacity: 0.6;")">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.subtitle2">
                                        @assignment.TechnicianName
                                        @if (assignment.IsActive)
                                        {
                                            <MudChip T="string"
                                                     Color="Color.Success"
                                                     Size="Size.Small"
                                                     Class="ml-1">
                                                Active
                                            </MudChip>
                                        }
                                    </MudText>
                                    <MudText Typo="Typo.caption">
                                        @assignment.AssignedAt.ToString("dd.MM.yyyy HH:mm")
                                        by @assignment.AssignedByName
                                    </MudText>
                                    @if (!string.IsNullOrWhiteSpace(assignment.Note))
                                    {
                                        <MudText Typo="Typo.body2">@assignment.Note</MudText>
                                    }
                                </div>
                                <MudSpacer />
                                <div>
                                    <MudText Typo="Typo.caption">
                                        @assignment.Interventions.Count intervention(s)
                                    </MudText>
                                    @if (assignment.Interventions.Any(i =>
                                                                            i.InterventionStatusName == "Failed"))
                                    {
                                        <MudChip T="string" Color="Color.Error"
                                                 Size="Size.Small">Failed</MudChip>
                                    }
                                    @if (assignment.Interventions.Any(i =>
                                                                            i.InterventionStatusName == "Completed"))
                                    {
                                        <MudChip T="string" Color="Color.Success"
                                                 Size="Size.Small">Completed</MudChip>
                                    }
                                </div>
                            </MudStack>
                        </MudPaper>
                    }
                </MudPaper>
            }

            <MudPaper Class="pa-4 mb-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Timeline"
                             Color="Color.Primary"
                             Size="Size.Small"
                             Class="mr-1" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">
                        Timeline
                    </MudText>
                </MudStack>
                <FaultReportTimeline FaultReportId="@Id" @key="timelineKey" />
            </MudPaper>
        </MudItem>

        @if (CurrentUser.HasAnyRole("Admin", "Manager"))
        {
            <MudItem xs="12" md="4">

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <MudAlert Severity="@messageSeverity"
                              Class="mb-3"
                              ShowCloseIcon="true"
                              CloseIconClicked="@(() => message = null)">
                        @message
                    </MudAlert>
                }

                @if (report.FaultStatusName != "Closed")
                {
                    @* Review sekcija *@
                    <MudPaper Class="pa-4 mb-3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.RateReview"
                                     Color="Color.Primary"
                                     Size="Size.Small"
                                     Class="mr-1" />
                            <MudText Typo="Typo.subtitle1"
                                     Style="font-weight: 600;">
                                Review
                            </MudText>
                            <MudSpacer />
                            @if (!editingReview &&
                                                     report.FaultTypeName is not null)
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               Title="Edit review"
                                               OnClick="@(() => editingReview = true)" />
                            }
                        </MudStack>

                        @if (editingReview || report.FaultTypeName is null)
                        {
                            @* Forma za review *@
                            <MudSelect T="int?"
                                       @bind-Value="reviewForm.FaultTypeId"
                                       Label="Fault Type"
                                       Variant="Variant.Outlined"
                                       Class="mb-3"
                                       Clearable="true">
                                @foreach (var t in faultTypes)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)t.Id)">
                                        @t.Name
                                    </MudSelectItem>
                                }
                            </MudSelect>

                            <MudSelect T="int?"
                                       @bind-Value="reviewForm.FaultPriorityId"
                                       Label="Priority"
                                       Variant="Variant.Outlined"
                                       Class="mb-3"
                                       Clearable="true">
                                @foreach (var p in priorities)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)p.Id)">
                                        @p.Name
                                    </MudSelectItem>
                                }
                            </MudSelect>

                            <MudDatePicker @bind-Date="deadline"
                                           Label="Deadline"
                                           Variant="Variant.Outlined"
                                           Class="mb-3" />

                            <MudStack Row="true">
                                @if (editingReview)
                                {
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Save"
                                               OnClick="SaveReview">
                                        Save Review
                                    </MudButton>
                                    <MudButton Variant="Variant.Text"
                                               Size="Size.Small"
                                               OnClick="@(() => editingReview = false)">
                                        Cancel
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.RateReview"
                                               OnClick="SaveReview">
                                        Submit Review
                                    </MudButton>
                                }
                            </MudStack>
                        }
                        else
                        {
                            @* Prikaz review podataka *@
                            <MudGrid>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption"
                                             Style="color: var(--mud-palette-text-secondary);">
                                        FAULT TYPE
                                    </MudText>
                                    <MudText Typo="Typo.body2"
                                             Style="font-weight: 500;">
                                        @(report.FaultTypeName ?? "—")
                                    </MudText>
                                </MudItem>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption"
                                             Style="color: var(--mud-palette-text-secondary);">
                                        PRIORITY
                                    </MudText>
                                    @if (report.FaultPriorityName is not null)
                                    {
                                        <MudChip T="string"
                                                 Color="@GetPriorityColor(report.FaultPriorityName)"
                                                 Size="Size.Small"
                                                 Style="margin: 0;">
                                            @report.FaultPriorityName
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2">—</MudText>
                                    }
                                </MudItem>
                                <MudItem xs="12">
                                    <MudText Typo="Typo.caption"
                                             Style="color: var(--mud-palette-text-secondary);">
                                        DEADLINE
                                    </MudText>
                                    <MudText Typo="Typo.body2"
                                             Style="font-weight: 500;">
                                        @(report.Deadline?.ToString("dd.MM.yyyy") ?? "—")
                                    </MudText>
                                </MudItem>
                            </MudGrid>
                        }
                    </MudPaper>

                    @* Assignment sekcija *@
                    <MudPaper Class="pa-4 mb-3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Engineering"
                                     Color="Color.Secondary"
                                     Size="Size.Small"
                                     Class="mr-1" />
                            <MudText Typo="Typo.subtitle1"
                                     Style="font-weight: 600;">
                                Assignment
                            </MudText>
                            <MudSpacer />
                            @if (!editingAssignment &&
                                                     report.ActiveTechnicianName is not null &&
                                                     !report.HasFailedIntervention)
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               Title="Edit assignment (no history)"
                                               OnClick="@(() => editingAssignment = true)" />
                            }
                        </MudStack>

                        @if (report.FaultStatusName == "Resolved")
                        {
                            <MudAlert Severity="Severity.Success" Dense="true">
                                Intervention completed successfully.
                            </MudAlert>
                        }
                        else if (editingAssignment ||
                                 report.ActiveTechnicianName is null)
                        {
                            <MudSelect T="int"
                                       @bind-Value="assignTechnicianId"
                                       Label="Select Technician"
                                       Variant="Variant.Outlined"
                                       Class="mb-3">
                                @foreach (var t in technicians)
                                {
                                    <MudSelectItem T="int" Value="@t.Id">
                                        @t.Name
                                    </MudSelectItem>
                                }
                            </MudSelect>

                            <MudTextField @bind-Value="assignNote"
                                          Label="Note (optional)"
                                          Variant="Variant.Outlined"
                                          Class="mb-3" />

                            <MudStack Row="true">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Secondary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Engineering"
                                           OnClick="AssignTechnician">
                                    @(report.HasFailedIntervention
                                        ? "Reassign Technician"
                                        : report.ActiveTechnicianName is null
                                            ? "Assign Technician"
                                            : "Update Assignment")
                                </MudButton>
                                @if (editingAssignment)
                                {
                                    <MudButton Variant="Variant.Text"
                                               Size="Size.Small"
                                               OnClick="@(() => editingAssignment = false)">
                                        Cancel
                                    </MudButton>
                                }
                            </MudStack>
                        }
                        else
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudAvatar Color="Color.Secondary"
                                           Size="Size.Small"
                                           Style="font-size: 0.75rem;">
                                    @report.ActiveTechnicianName[0]
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.body2"
                                             Style="font-weight: 500;">
                                        @report.ActiveTechnicianName
                                    </MudText>
                                    <MudText Typo="Typo.caption"
                                             Style="color: var(--mud-palette-text-secondary);">
                                        Currently assigned
                                    </MudText>
                                </div>
                                <MudSpacer />
                                @if (report.HasFailedIntervention)
                                {
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => editingAssignment = true)">
                                        Reassign
                                    </MudButton>
                                }
                            </MudStack>
                        }
                    </MudPaper>

                    @* Close Report *@
                    @if (report.FaultStatusName == "Resolved")
                    {
                        <MudPaper Class="pa-4 mb-3"
                                  Style="border: 1px solid var(--mud-palette-success);">
                            <MudText Typo="Typo.subtitle1"
                                     Style="font-weight: 600;"
                                     Class="mb-2">
                                Close Report
                            </MudText>
                            <MudText Typo="Typo.body2"
                                     Class="mb-3"
                                     Style="color: var(--mud-palette-text-secondary);">
                                Intervention has been completed. Review photos and close.
                            </MudText>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.CheckCircle"
                                       OnClick="CloseReport">
                                Close Report
                            </MudButton>
                        </MudPaper>
                    }
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Class="mb-3">
                        <MudText Typo="Typo.subtitle2">Report Closed</MudText>
                        <MudText Typo="Typo.body2">
                            This report has been successfully closed.
                        </MudText>
                    </MudAlert>
                }

                @* AI Summary — na dnu *@
                <MudPaper Class="pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome"
                                 Size="Size.Small"
                                 Class="mr-1"
                                 Style="color: #7c4dff;" />
                        <MudText Typo="Typo.subtitle1"
                                 Style="font-weight: 600;">
                            AI Summary
                        </MudText>
                    </MudStack>
                    @if (aiSummary is not null)
                    {
                        <MudText Typo="Typo.body2"
                                 Class="mb-3"
                                 Style="line-height: 1.6;">
                            @aiSummary
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2"
                                 Class="mb-3"
                                 Style="color: var(--mud-palette-text-secondary);">
                            Generate an AI summary of this report including
                            interventions and materials used.
                        </MudText>
                    }
                    <MudButton Variant="Variant.Outlined"
                               FullWidth="true"
                               Disabled="isLoadingSummary"
                               StartIcon="@Icons.Material.Filled.AutoAwesome"
                               OnClick="GetAiSummary">
                        @(isLoadingSummary ? "Generating..." : "Generate Summary")
                    </MudButton>
                </MudPaper>

            </MudItem>
        }
    </MudGrid>
}

@code {
    [Parameter] public int Id { get; set; }

    private FaultReportDto? report;
    private List<AttachmentDto> attachments = new();
    private List<LookupDto> faultTypes = new();
    private List<LookupDto> priorities = new();
    private List<LookupDto> technicians = new();
    private FaultReportUpdateDto reviewForm = new();
    private DateTime? deadline;
    private int assignTechnicianId;
    private int timelineKey = 0;
    private string assignNote = "";
    private List<WorkAssignmentDto> assignmentHistory = new();
    private bool isLoading = true;
    private string? message;
    private Severity messageSeverity = Severity.Success;
    private string? aiSummary;
    private bool isLoadingSummary = false;
    private bool editingReview = false;
    private bool editingAssignment = false;
    private bool editingDetails = false;
    private string editTitle = "";
    private string editDescription = "";

    private List<AttachmentDto> BeforePhotos =>
        attachments.Where(a => a.Purpose == "Photo Before Work" &&
            a.ContentType.StartsWith("image/")).ToList();

    private List<AttachmentDto> AfterPhotos =>
        attachments.Where(a => a.Purpose == "Photo After Work" &&
            a.ContentType.StartsWith("image/")).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var t1 = Http.GetFromJsonAsync<FaultReportDto>($"api/faultreports/{Id}");
            var t2 = Http.GetFromJsonAsync<List<AttachmentDto>>(
                $"api/attachments/fault-report/{Id}");
            var t3 = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/fault-types");
            var t4 = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/fault-priorities");
            var t5 = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/technicians");

            await Task.WhenAll(t1, t2, t3, t4, t5);

            report = t1.Result;
            attachments = t2.Result ?? new();
            faultTypes = t3.Result ?? new();
            priorities = t4.Result ?? new();
            technicians = t5.Result ?? new();

            if (report is not null)
            {
                reviewForm.FaultTypeId = report.FaultTypeId;
                reviewForm.FaultPriorityId = report.FaultPriorityId;
                deadline = report.Deadline;
                editTitle = report.Title;
                editDescription = report.Description;
            }

            if (CurrentUser.HasAnyRole("Admin", "Manager"))
            {
                try
                {
                    assignmentHistory = await Http.GetFromJsonAsync<List<WorkAssignmentDto>>(
                        $"api/workassignments/fault-report/{Id}") ?? new();
                }
                catch { }
            }

            timelineKey++;
        }
        catch { }
        finally { isLoading = false; }
    }

    private async Task ReloadAttachments()
    {
        attachments = await Http.GetFromJsonAsync<List<AttachmentDto>>(
            $"api/attachments/fault-report/{Id}") ?? new();
    }

    private async Task GetAiSummary()
    {
        isLoadingSummary = true;
        try
        {
            var response = await Http.GetAsync($"api/ai/summarize/{Id}");
            if (response.IsSuccessStatusCode)
                aiSummary = await response.Content.ReadAsStringAsync();
        }
        catch { }
        finally { isLoadingSummary = false; }
    }

    private void CancelEditDetails()
    {
        editTitle = report?.Title ?? "";
        editDescription = report?.Description ?? "";
        editingDetails = false;
    }

    private async Task SaveDetails()
    {
        try
        {
            var dto = new FaultReportCreateDto
            {
                Title = editTitle,
                Description = editDescription,
                LocationId = report!.LocationId,
                ReportedByEmployeeId = report.ReportedByEmployeeId
            };

            var response = await Http.PutAsJsonAsync(
                $"api/faultreports/{Id}/edit", dto);

            if (response.IsSuccessStatusCode)
            {
                editingDetails = false;
                message = "Report updated.";
                messageSeverity = Severity.Success;
                await LoadData();
            }
            else
            {
                message = await response.Content.ReadAsStringAsync();
                messageSeverity = Severity.Error;
            }
        }
        catch { }
    }

    private async Task SaveReview()
    {
        try
        {
            reviewForm.Deadline = deadline;
            var response = await Http.PutAsJsonAsync(
                $"api/faultreports/{Id}/review", reviewForm);

            if (response.IsSuccessStatusCode)
            {
                editingReview = false;
                message = "Review saved.";
                messageSeverity = Severity.Success;
                await LoadData();
            }
            else
            {
                message = await response.Content.ReadAsStringAsync();
                messageSeverity = Severity.Error;
            }
        }
        catch { }
    }

    private async Task AssignTechnician()
    {
        if (assignTechnicianId == 0)
        {
            message = "Please select a technician.";
            messageSeverity = Severity.Error;
            return;
        }

        try
        {
            HttpResponseMessage response;

            if (report!.HasFailedIntervention)
            {
                var dto = new WorkAssignmentCreateDto
                {
                    FaultReportId = Id,
                    TechnicianId = assignTechnicianId,
                    Note = assignNote
                };
                response = await Http.PostAsJsonAsync("api/workassignments", dto);
            }
            else
            {
                var activeAssignment = assignmentHistory.FirstOrDefault(a => a.IsActive);
                if (activeAssignment is not null)
                {
                    var dto = new WorkAssignmentCreateDto
                    {
                        FaultReportId = Id,
                        TechnicianId = assignTechnicianId,
                        Note = assignNote
                    };
                    response = await Http.PutAsJsonAsync(
                        $"api/workassignments/{activeAssignment.Id}/technician", dto);
                }
                else
                {
                    var dto = new WorkAssignmentCreateDto
                    {
                        FaultReportId = Id,
                        TechnicianId = assignTechnicianId,
                        Note = assignNote
                    };
                    response = await Http.PostAsJsonAsync("api/workassignments", dto);
                }
            }

            if (response.IsSuccessStatusCode)
            {
                editingAssignment = false;
                message = report!.HasFailedIntervention
                    ? "Technician reassigned. New assignment created."
                    : "Assignment updated.";
                messageSeverity = Severity.Success;
                await LoadData();
            }
            else
            {
                message = await response.Content.ReadAsStringAsync();
                messageSeverity = Severity.Error;
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            messageSeverity = Severity.Error;
        }
    }

    private async Task CloseReport()
    {
        try
        {
            var response = await Http.PutAsJsonAsync(
                $"api/faultreports/{Id}/close", new { });

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/fault-reports");
            }
            else
            {
                message = await response.Content.ReadAsStringAsync();
                messageSeverity = Severity.Error;
            }
        }
        catch { }
    }

    private Color GetPriorityColor(string? priority) => priority switch
    {
        "Critical" => Color.Error,
        "High" => Color.Warning,
        "Medium" => Color.Info,
        _ => Color.Default
    };

    private Color GetStatusColor(string? status) => status switch
    {
        "Closed" => Color.Success,
        "Resolved" => Color.Info,
        "In Progress" => Color.Warning,
        "Assigned" => Color.Secondary,
        "Reviewed" => Color.Primary,
        _ => Color.Default
    };
}