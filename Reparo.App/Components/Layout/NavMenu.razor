@using Reparo.App.Services
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation
@implements IDisposable

<MudNavMenu Class="pa-2">
    @if (!CurrentUser.IsLoggedIn)
    {
        <MudNavLink Href="/"
                    Icon="@Icons.Material.Filled.Login"
                    Match="NavLinkMatch.All">
            Sign In
        </MudNavLink>
    }
    else
    {
        <MudNavLink Href="/"
                    Icon="@Icons.Material.Filled.Dashboard"
                    Match="NavLinkMatch.All">
            Dashboard
        </MudNavLink>

        @if (CurrentUser.HasAnyRole("Admin", "Manager"))
        {
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.caption"
                     Class="px-4 py-1"
                     Style="color: var(--mud-palette-text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">
                Management
            </MudText>
            
            <MudNavLink Href="/fault-reports"
                        Icon="@Icons.Material.Filled.BugReport">
                Fault Reports
            </MudNavLink>

            <MudNavLink Href="/locations"
                        Icon="@Icons.Material.Filled.LocationOn">
                Locations
            </MudNavLink>

            <MudNavLink Href="/employees"
                        Icon="@Icons.Material.Filled.Badge">
                Employees
            </MudNavLink>

            <MudNavLink Href="/assignments"
                        Icon="@Icons.Material.Filled.Assignment">
                Assignments
            </MudNavLink>

            <MudNavLink Href="/interventions"
                        Icon="@Icons.Material.Filled.Build">
                Interventions
            </MudNavLink>

            <MudNavLink Href="/materials"
                        Icon="@Icons.Material.Filled.Inventory">
                Materials
            </MudNavLink>

            <MudNavLink Href="/sla"
                        Icon="@Icons.Material.Filled.Analytics">
                SLA Reports
            </MudNavLink>
        }

        @if (CurrentUser.HasRole("Admin"))
        {
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.caption"
                     Class="px-4 py-1"
                     Style="color: var(--mud-palette-text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">
                Admin
            </MudText>

            <MudNavLink Href="/users"
                        Icon="@Icons.Material.Filled.People">
                Users
            </MudNavLink>
        }

        @if (CurrentUser.HasRole("Reporter"))
        {
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.caption"
                     Class="px-4 py-1"
                     Style="color: var(--mud-palette-text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">
                My Work
            </MudText>

            <MudNavLink Href="/my-reports"
                        Icon="@Icons.Material.Filled.ListAlt">
                My Reports
            </MudNavLink>
        }

        @if (CurrentUser.HasRole("Technician"))
        {
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.caption"
                     Class="px-4 py-1"
                     Style="color: var(--mud-palette-text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">
                My Work
            </MudText>

            <MudNavLink Href="/my-assignments"
                        Icon="@Icons.Material.Filled.Engineering">
                My Assignments
            </MudNavLink>
        }

        @if (CurrentUser.HasRole("Admin"))
        {
            <MudNavLink Href="/lookups"
                        Icon="@Icons.Material.Filled.TableChart">
                Lookup Data
            </MudNavLink>
        }

        <MudDivider Class="my-2" />

        <MudNavLink Icon="@Icons.Material.Filled.Logout"
                    OnClick="HandleLogout"
                    Style="color: var(--mud-palette-error);">
            Sign Out
        </MudNavLink>
    }
</MudNavMenu>

@code {
    protected override void OnInitialized()
    {
        CurrentUser.UserChanged += HandleUserChanged;
    }

    private void HandleUserChanged() => InvokeAsync(StateHasChanged);

    private void HandleLogout()
    {
        CurrentUser.Logout();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        CurrentUser.UserChanged -= HandleUserChanged;
    }
}