@using MudBlazor
@using Reparo.Shared.DTOs
@using Reparo.App.Services
@inject HttpClient Http
@inject IDialogService DialogService

<MudDialogContent Style="padding: 32px;">
    <MudStack Spacing="4">

        @* Lista materijala *@
        @if (materialForms.Any() || Intervention.Materials.Any())
        {
            <div>
                <MudText Typo="Typo.subtitle1"
                         Style="font-weight: 600;"
                         GutterBottom="true">
                    Materials
                </MudText>

                @* Već dodani materijali *@
                @foreach (var mat in Intervention.Materials)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center"
                              Spacing="2" Class="mb-1">
                        <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord"
                                 Size="Size.Small"
                                 Color="Color.Primary"
                                 Style="font-size: 8px;" />
                        <MudText Typo="Typo.body2">
                            @mat.MaterialName —
                            <strong>@mat.Quantity @mat.MaterialUnitName</strong>
                        </MudText>
                    </MudStack>
                }

                @* Forme za novi materijal *@
                @for (int i = 0; i < materialForms.Count; i++)
                {
                    var index = i;
                    var form = materialForms[index];
                    <MudPaper Outlined="true" Class="pa-3 mb-2">
                        <MudGrid>
                            <MudItem xs="12" sm="5">
                                <MudTextField @bind-Value="form.Name"
                                              Label="Material Name"
                                              Variant="Variant.Outlined"
                                              Placeholder="e.g. Cable 2.5mm" />
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudNumericField @bind-Value="form.Quantity"
                                                 Label="Quantity"
                                                 Variant="Variant.Outlined"
                                                 Min="0.01m" />
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudSelect T="int"
                                           @bind-Value="form.UnitId"
                                           Label="Unit"
                                           Variant="Variant.Outlined">
                                    <MudSelectItem T="int" Value="0" Disabled="true">
                                        Select...
                                    </MudSelectItem>
                                    @foreach (var u in MaterialUnits)
                                    {
                                        <MudSelectItem T="int" Value="@u.Id">
                                            @u.Name
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="1"
                                     Class="d-flex align-center justify-end">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => materialForms.RemoveAt(index))" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                }
            </div>
        }

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddMaterialForm">
            Add Material
        </MudButton>

        <MudDivider />

        @* Finish *@
        <div>
            <MudText Typo="Typo.subtitle1"
                     Style="font-weight: 600;"
                     GutterBottom="true">
                Finish Intervention
            </MudText>
            <MudGrid>
                <MudItem xs="6">
                    <MudDatePicker @bind-Date="startDate"
                                   Label="Start Date"
                                   Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    <MudTimePicker @bind-Time="startTime"
                                   Label="Start Time"
                                   Variant="Variant.Outlined"
                                   AmPm="false" />
                </MudItem>
                <MudItem xs="6">
                    <MudDatePicker @bind-Date="endDate"
                                   Label="End Date"
                                   Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    <MudTimePicker @bind-Time="endTime"
                                   Label="End Time"
                                   Variant="Variant.Outlined"
                                   AmPm="false" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="finishNote"
                                  Label="Note"
                                  Variant="Variant.Outlined"
                                  Lines="2"
                                  HelperText="Required — describe what was done" />
                </MudItem>
            </MudGrid>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <MudAlert Severity="Severity.Error">@error</MudAlert>
        }

    </MudStack>
</MudDialogContent>

<MudDialogActions Style="padding: 16px 32px 24px 32px;">
    <MudButton OnClick="Cancel" Variant="Variant.Text">Close</MudButton>
    <MudSpacer />
    <MudButton Variant="Variant.Filled"
               Color="Color.Error"
               StartIcon="@Icons.Material.Filled.Cancel"
               Class="mr-2"
               OnClick="ConfirmMarkAsFailed">
        Mark as Failed
    </MudButton>
    <MudButton Variant="Variant.Filled"
               Color="Color.Success"
               StartIcon="@Icons.Material.Filled.CheckCircle"
               OnClick="@(() => Finish(true))">
        Complete Successfully
    </MudButton>
</MudDialogActions>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public InterventionDto Intervention { get; set; } = null!;
    [Parameter] public List<LookupDto> MaterialUnits { get; set; } = new();
    [Parameter] public EventCallback OnMaterialAdded { get; set; }

    private class MaterialForm
    {
        public string Name { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1;
        public int UnitId { get; set; } = 0;
    }

    private List<MaterialForm> materialForms = new();
    private DateTime? startDate = DateTime.Today;
    private TimeSpan? startTime;
    private DateTime? endDate = DateTime.Today;
    private TimeSpan? endTime;
    private string finishNote = string.Empty;
    private string? error;

    private void AddMaterialForm()
    {
        materialForms.Add(new MaterialForm());
    }

    private async Task ConfirmMarkAsFailed()
    {
        var parameters = new DialogParameters
        {
            ["Message"] = "Are you sure you want to mark this intervention as failed?",
            ["ConfirmText"] = "Mark as Failed",
            ["ConfirmColor"] = Color.Error
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true,
            BackdropClick = true
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "Confirm", parameters, options);

        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await Finish(false);
    }

    private async Task Finish(bool successful)
    {
        error = null;

        if (string.IsNullOrWhiteSpace(finishNote))
        {
            error = "Note is required.";
            return;
        }

        if (!startDate.HasValue || !startTime.HasValue ||
            !endDate.HasValue || !endTime.HasValue)
        {
            error = "Please enter start and end date/time.";
            return;
        }

        var startDateTime = startDate.Value.Date + startTime.Value;
        var endDateTime = endDate.Value.Date + endTime.Value;

        if (endDateTime <= startDateTime)
        {
            error = "End time must be after start time.";
            return;
        }

        // Spremi materijale
        foreach (var form in materialForms)
        {
            if (string.IsNullOrWhiteSpace(form.Name) || form.UnitId == 0)
                continue;

            try
            {
                var materialsLookup = await Http.GetFromJsonAsync<List<LookupDto>>(
                    "api/lookups/materials") ?? new();

                var existing = materialsLookup.FirstOrDefault(m =>
                    m.Name.Equals(form.Name, StringComparison.OrdinalIgnoreCase));

                int materialId;

                if (existing is not null)
                {
                    materialId = existing.Id;
                }
                else
                {
                    var createResponse = await Http.PostAsJsonAsync("api/materials",
                        new CreateMaterialDto { Name = form.Name });

                    if (!createResponse.IsSuccessStatusCode) continue;

                    var newMaterial = await createResponse.Content
                        .ReadFromJsonAsync<LookupDto>();
                    materialId = newMaterial!.Id;
                }

                var dto = new InterventionMaterialCreateDto
                {
                    InterventionId = Intervention.Id,
                    MaterialId = materialId,
                    Quantity = form.Quantity,
                    MaterialUnitId = form.UnitId
                };

                await Http.PostAsJsonAsync(
                    $"api/interventions/{Intervention.Id}/materials", dto);
            }
            catch { }
        }

        // Završi intervenciju
        var finishDto = new InterventionFinishDto
        {
            Id = Intervention.Id,
            StartedAt = startDateTime,
            FinishedAt = endDateTime,
            Note = finishNote,
            IsSuccessful = successful
        };

        var response = await Http.PutAsJsonAsync(
            $"api/interventions/{Intervention.Id}/finish", finishDto);

        if (response.IsSuccessStatusCode)
        {
            MudDialog.Close(DialogResult.Ok(successful));
        }
        else
        {
            error = await response.Content.ReadAsStringAsync();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}