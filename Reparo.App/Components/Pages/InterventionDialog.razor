@using MudBlazor
@using Reparo.Shared.DTOs
@using Reparo.App.Services
@inject HttpClient Http
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Intervention</MudText>
    </TitleContent>
    <DialogContent>
        <div style="padding: 8px 4px;">
            <MudStack Spacing="4">

                @* Materijali *@
                @if (Dto?.Materials?.Any() == true || materialForms.Any())
                {
                    <div>
                        <MudText Typo="Typo.subtitle1"
                                 Style="font-weight: 600;"
                                 GutterBottom="true">
                            Materials
                        </MudText>
                        @foreach (var mat in Dto?.Materials ?? new())
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center"
                                      Spacing="2" Class="mb-1">
                                <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord"
                                         Size="Size.Small"
                                         Color="Color.Primary"
                                         Style="font-size: 8px;" />
                                <MudText Typo="Typo.body2">
                                    @mat.MaterialName —
                                    <strong>@mat.Quantity @mat.MaterialUnitName</strong>
                                </MudText>
                            </MudStack>
                        }
                    </div>
                }

                <MudDivider />

                @* Dodaj materijal *@
                <div>
                    <MudText Typo="Typo.subtitle1"
                             Style="font-weight: 600;"
                             GutterBottom="true">
                        Add Material
                    </MudText>
                    @for (int i = 0; i < materialForms.Count; i++)
                    {
                        var index = i;
                        var form = materialForms[index];
                        <MudPaper Outlined="true" Class="pa-3 mb-2">
                            <MudGrid>
                                <MudItem xs="12" sm="5">
                                    <MudTextField @bind-Value="form.Name"
                                                  Label="Material Name"
                                                  Variant="Variant.Outlined"
                                                  FullWidth="true"
                                                  Dense="true"
                                                  Placeholder="e.g. Cable" />
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudNumericField @bind-Value="form.Quantity"
                                                     Label="Quantity"
                                                     Variant="Variant.Outlined"
                                                     FullWidth="true"
                                                     Dense="true"
                                                     Min="0.01m" />
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudSelect T="int"
                                               @bind-Value="form.UnitId"
                                               Label="Unit"
                                               Variant="Variant.Outlined"
                                               FullWidth="true"
                                               Dense="true">
                                        <MudSelectItem T="int" Value="0" Disabled="true">
                                            Select...
                                        </MudSelectItem>
                                        @foreach (var u in Units)
                                        {
                                            <MudSelectItem T="int" Value="@u.Id">
                                                @u.Name
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="1"
                                         Class="d-flex align-center justify-end">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => materialForms.RemoveAt(index))" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddMaterialForm">
                        Add Material
                    </MudButton>
                </div>

                <MudDivider />

                @* Upload foto *@
                <AttachmentUpload FaultReportId="@FaultReportId"
                                  Attachments="@Attachments"
                                  FixedPurpose="Photo After Work"
                                  OnAttachmentChanged="OnAttachmentChanged" />

                <MudDivider />

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@error</MudAlert>
                }

                @* Finish *@
                <div>
                    <MudText Typo="Typo.subtitle1"
                             Style="font-weight: 600;"
                             GutterBottom="true">
                        Finish Intervention
                    </MudText>
                    <MudGrid>
                        @* xs=12/sm=6 umjesto xs=6: na mobitelu su date/time polja puna
                           širina jedno ispod drugog, na tabletu/desktopu 2 u redu *@
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="startDate"
                                           Label="Start Date"
                                           Variant="Variant.Outlined"
                                           FullWidth="true"
                                           Dense="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTimePicker @bind-Time="startTime"
                                           Label="Start Time"
                                           Variant="Variant.Outlined"
                                           FullWidth="true"
                                           Dense="true"
                                           AmPm="false" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="endDate"
                                           Label="End Date"
                                           Variant="Variant.Outlined"
                                           FullWidth="true"
                                           Dense="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTimePicker @bind-Time="endTime"
                                           Label="End Time"
                                           Variant="Variant.Outlined"
                                           FullWidth="true"
                                           Dense="true"
                                           AmPm="false" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="finishNote"
                                          Label="Note"
                                          Variant="Variant.Outlined"
                                          FullWidth="true"
                                          Dense="true"
                                          Lines="2"
                                          HelperText="Required" />
                        </MudItem>
                    </MudGrid>
                </div>

            </MudStack>
        </div>
    </DialogContent>
    <DialogActions>
        @* Desktop: gumbi jedan pored drugog, poravnati desno *@
        <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
            <MudStack Row="false" Spacing="2" Class="px-4 py-2" Style="width: 100%;">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.CheckCircle"
                           FullWidth="true"
                           Class="py-3"
                           Style="text-transform:none; font-size:1rem;"
                           OnClick="@(() => Finish(true))">
                    Complete Successfully
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Cancel"
                           FullWidth="true"
                           Class="py-3"
                           Style="text-transform:none; font-size:1rem;"
                           OnClick="ConfirmMarkAsFailed">
                    Mark as Failed
                </MudButton>
            </MudStack>
        </MudHidden>

        @* Mobitel: gumbi puna širina, jedan iznad drugog, čitljivi *@
        <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
            <MudStack Row="false" Spacing="2" Class="px-4 py-2" Style="width: 100%;">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.CheckCircle"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="@(() => Finish(true))">
                    Complete Successfully
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Cancel"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="ConfirmMarkAsFailed">
                    Mark as Failed
                </MudButton>
            </MudStack>
        </MudHidden>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public InterventionDto Dto { get; set; } = null!;
    [Parameter] public List<LookupDto> Units { get; set; } = new();
    [Parameter] public int FaultReportId { get; set; }
    [Parameter] public List<AttachmentDto> Attachments { get; set; } = new();
    [Parameter] public EventCallback OnMaterialAdded { get; set; }
    [Parameter] public EventCallback OnAttachmentChanged { get; set; }

    private class MaterialForm
    {
        public string Name { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1;
        public int UnitId { get; set; } = 0;
    }

    private List<MaterialForm> materialForms = new();
    private DateTime? startDate = DateTime.Today;
    private TimeSpan? startTime;
    private DateTime? endDate = DateTime.Today;
    private TimeSpan? endTime;
    private string finishNote = string.Empty;
    private string? error;

    private void AddMaterialForm()
    {
        materialForms.Add(new MaterialForm());
    }

    private async Task ConfirmMarkAsFailed()
    {
        var parameters = new DialogParameters
        {
            ["Message"] = "Are you sure you want to mark this intervention as failed?",
            ["ConfirmText"] = "Mark as Failed",
            ["ConfirmColor"] = Color.Error
        };

        var options = new DialogOptions
        {
            FullWidth = true,
            MaxWidth = MaxWidth.Small,
            CloseOnEscapeKey = true
        };

        await DialogService.ShowAsync<InterventionDialog>("Intervention", parameters, options);

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "Confirm", parameters, options);

        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await Finish(false);
    }

    private async Task Finish(bool successful)
    {
        error = null;

        if (string.IsNullOrWhiteSpace(finishNote))
        {
            error = "Note is required.";
            return;
        }

        if (!startDate.HasValue || !startTime.HasValue ||
            !endDate.HasValue || !endTime.HasValue)
        {
            error = "Please enter start and end date/time.";
            return;
        }

        var startDateTime = startDate.Value.Date + startTime.Value;
        var endDateTime = endDate.Value.Date + endTime.Value;

        if (endDateTime <= startDateTime)
        {
            error = "End time must be after start time.";
            return;
        }

        // Spremi materijale
        foreach (var form in materialForms)
        {
            if (string.IsNullOrWhiteSpace(form.Name) || form.UnitId == 0)
                continue;

            try
            {
                var materialsLookup = await Http.GetFromJsonAsync<List<LookupDto>>(
                    "api/lookups/materials") ?? new();

                var existing = materialsLookup.FirstOrDefault(m =>
                    m.Name.Equals(form.Name, StringComparison.OrdinalIgnoreCase));

                int materialId;

                if (existing is not null)
                {
                    materialId = existing.Id;
                }
                else
                {
                    var createResponse = await Http.PostAsJsonAsync("api/materials",
                        new CreateMaterialDto { Name = form.Name });

                    if (!createResponse.IsSuccessStatusCode) continue;

                    var newMaterial = await createResponse.Content
                        .ReadFromJsonAsync<LookupDto>();
                    materialId = newMaterial!.Id;
                }

                var dto = new InterventionMaterialCreateDto
                {
                    InterventionId = Dto.Id,
                    MaterialId = materialId,
                    Quantity = form.Quantity,
                    MaterialUnitId = form.UnitId
                };

                await Http.PostAsJsonAsync(
                    $"api/interventions/{Dto.Id}/materials", dto);
            }
            catch { }
        }

        var finishDto = new InterventionFinishDto
        {
            Id = Dto.Id,
            StartedAt = startDateTime,
            FinishedAt = endDateTime,
            Note = finishNote,
            IsSuccessful = successful
        };

        var response = await Http.PutAsJsonAsync(
            $"api/interventions/{Dto.Id}/finish", finishDto);

        if (response.IsSuccessStatusCode)
        {
            MudDialog.Close(DialogResult.Ok(successful));
        }
        else
        {
            error = await response.Content.ReadAsStringAsync();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}