@page "/my-reports"
@inject HttpClient Http
@inject CurrentUserService CurrentUser

<PageTitle>My Reports - Reparo</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">My Reports</MudText>

@if (!CurrentUser.HasAnyRole("Reporter", "Admin"))
{
    <MudAlert Severity="Severity.Warning">Access denied.</MudAlert>
}
else
{
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Class="mb-4"
               OnClick="OpenCreateForm">
        New Report
    </MudButton>

    @if (showForm)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">New Fault Report</MudText>

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="form.Title"
                                  Label="Title"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int"
                               @bind-Value="form.LocationId"
                               Label="Location"
                               Variant="Variant.Outlined">
                        @foreach (var l in locations)
                        {
                            <MudSelectItem T="int" Value="@l.Id">@l.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="form.Description"
                                  Label="Description"
                                  Variant="Variant.Outlined"
                                  Lines="3" />
                </MudItem>
            </MudGrid>

            <MudStack Row="true" Class="mt-3">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="SaveReport">
                    Submit
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           OnClick="@(() => showForm = false)">
                    Cancel
                </MudButton>
            </MudStack>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <MudAlert Severity="@messageSeverity" Class="mt-3">
                    @message
                </MudAlert>
            }
        </MudPaper>
    }

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (reports.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No reports found.</MudAlert>
    }
    else
    {
        <MudTable Items="@reports" Hover="true" Striped="true" Dense="true">
            <HeaderContent>
                <MudTh>Title</MudTh>
                <MudTh>Location</MudTh>
                <MudTh>Priority</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Assigned To</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Deadline</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Title</MudTd>
                <MudTd>@context.LocationName</MudTd>
                <MudTd>@(context.FaultPriorityName ?? "-")</MudTd>
                <MudTd>
                    <MudChip T="string"
                             Color="@GetStatusColor(context.FaultStatusName)"
                             Size="Size.Small">
                        @context.FaultStatusName
                    </MudChip>
                </MudTd>
                <MudTd>@(context.ActiveTechnicianName ?? "Unassigned")</MudTd>
                <MudTd>@context.CreatedAt.ToString("dd.MM.yyyy")</MudTd>
                <MudTd>@(context.Deadline?.ToString("dd.MM.yyyy") ?? "-")</MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    private List<FaultReportDto> reports = new();
    private List<LookupDto> locations = new();
    private FaultReportCreateDto form = new();
    private bool isLoading = true;
    private bool showForm = false;
    private string? message;
    private Severity messageSeverity = Severity.Success;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var t1 = Http.GetFromJsonAsync<List<FaultReportDto>>("api/faultreports/mine");
            var t2 = Http.GetFromJsonAsync<List<LookupDto>>("api/locations/lookup");

            await Task.WhenAll(t1, t2);

            reports = t1.Result ?? new();
            locations = t2.Result ?? new();
        }
        catch { }
        finally { isLoading = false; }
    }

    private void OpenCreateForm()
    {
        form = new FaultReportCreateDto();

        if (CurrentUser.User?.EmployeeId is not null)
            form.ReportedByEmployeeId = CurrentUser.User.EmployeeId.Value;

        message = null;
        showForm = true;
    }

    private async Task SaveReport()
    {
        if (string.IsNullOrWhiteSpace(form.Title))
        {
            message = "Title is required.";
            messageSeverity = Severity.Error;
            return;
        }

        if (form.LocationId == 0)
        {
            message = "Please select a location.";
            messageSeverity = Severity.Error;
            return;
        }

        if (form.ReportedByEmployeeId == 0)
        {
            message = "Your account is not linked to an employee. Please contact admin.";
            messageSeverity = Severity.Error;
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/faultreports", form);

            if (response.IsSuccessStatusCode)
            {
                message = "Report submitted successfully.";
                messageSeverity = Severity.Success;
                showForm = false;
                await LoadData();
            }
            else
            {
                message = $"Error: {await response.Content.ReadAsStringAsync()}";
                messageSeverity = Severity.Error;
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            messageSeverity = Severity.Error;
        }
    }

    private Color GetStatusColor(string? status) => status switch
    {
        "Closed" => Color.Success,
        "Resolved" => Color.Info,
        "In Progress" => Color.Warning,
        _ => Color.Default
    };
}