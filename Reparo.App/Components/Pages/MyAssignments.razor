@page "/my-assignments"
@rendermode RenderMode.InteractiveServer
@inject HttpClient Http
@inject CurrentUserService CurrentUser

<PageTitle>My Assignments - Reparo</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">My Assignments</MudText>

@if (!CurrentUser.HasAnyRole("Technician", "Admin"))
{
    <MudAlert Severity="Severity.Warning">Access denied.</MudAlert>
}
else if (isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (assignments.Count == 0)
{
    <MudAlert Severity="Severity.Info">No assignments found.</MudAlert>
}
else
{
    @foreach (var assignment in assignments)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-1">@assignment.FaultReportTitle</MudText>
            <MudText Typo="Typo.body2" Class="mb-1">
                Location: @assignment.LocationName
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-1">
                Priority: @(assignment.FaultPriorityName == "" ? "-" : assignment.FaultPriorityName)
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                Status: @assignment.FaultStatusName
            </MudText>

            @if (assignment.IsActive)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Class="mb-3"
                           OnClick="@(() => StartIntervention(assignment.Id))">
                    Start Intervention
                </MudButton>
            }

            @if (assignment.Interventions.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-2">Interventions</MudText>
                @foreach (var intervention in assignment.Interventions)
                {
                    <MudPaper Class="pa-3 mb-2" Outlined="true">
                        <MudText Typo="Typo.body2">
                            Status: @intervention.InterventionStatusName
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Started: @(intervention.StartedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Finished: @(intervention.FinishedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Note: @(intervention.Note ?? "-")
                        </MudText>

                        @if (intervention.InterventionStatusName == "Planned" ||
                             intervention.InterventionStatusName == "Planirana")
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Class="mt-2 mr-2"
                                       OnClick="@(() => OpenFinishDialog(
                                           intervention, true))">
                                Finish Successfully
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       Class="mt-2"
                                       OnClick="@(() => OpenFinishDialog(
                                           intervention, false))">
                                Mark as Failed
                            </MudButton>

                            <MudDivider Class="my-3" />
                            <MudText Typo="Typo.subtitle2" Class="mb-2">
                                Add Material
                            </MudText>
                            <MudGrid>
                                <MudItem xs="12" sm="4">
                                    <MudSelect @bind-Value="materialForm.MaterialId"
                                               Label="Material"
                                               Variant="Variant.Outlined">
                                        @foreach (var m in materials)
                                        {
                                            <MudSelectItem Value="@m.Id">@m.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudNumericField @bind-Value="materialForm.Quantity"
                                                     Label="Quantity"
                                                     Variant="Variant.Outlined"
                                                     Min="0.01m" />
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudSelect @bind-Value="materialForm.MaterialUnitId"
                                               Label="Unit"
                                               Variant="Variant.Outlined">
                                        @foreach (var u in materialUnits)
                                        {
                                            <MudSelectItem Value="@u.Id">@u.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="2"
                                         Class="d-flex align-center">
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               OnClick="@(() => AddMaterial(
                                                   intervention.Id))">
                                        Add
                                    </MudButton>
                                </MudItem>
                            </MudGrid>
                        }
                    </MudPaper>
                }
            }
        </MudPaper>
    }
}

@if (showFinishDialog && finishingIntervention is not null)
{
    <MudDialog @bind-IsVisible="showFinishDialog">
        <TitleContent>
            <MudText Typo="Typo.h6">
                @(finishSuccessful ? "Finish Intervention" : "Mark as Failed")
            </MudText>
        </TitleContent>
        <DialogContent>
            <MudDatePicker @bind-Date="startDate"
                           Label="Start Date"
                           Variant="Variant.Outlined"
                           Class="mb-3" />
            <MudTimePicker @bind-Time="startTime"
                           Label="Start Time"
                           Variant="Variant.Outlined"
                           Class="mb-3" />
            <MudDatePicker @bind-Date="endDate"
                           Label="End Date"
                           Variant="Variant.Outlined"
                           Class="mb-3" />
            <MudTimePicker @bind-Time="endTime"
                           Label="End Time"
                           Variant="Variant.Outlined"
                           Class="mb-3" />
            <MudTextField @bind-Value="finishForm.Note"
                          Label="Note"
                          Variant="Variant.Outlined"
                          Lines="3"
                          Class="mb-3" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => showFinishDialog = false)">Cancel</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="@(finishSuccessful ? Color.Success : Color.Error)"
                       OnClick="FinishIntervention">
                Confirm
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private List<WorkAssignmentDto> assignments = new();
    private List<LookupDto> materials = new();
    private List<LookupDto> materialUnits = new();
    private InterventionMaterialCreateDto materialForm = new();
    private InterventionFinishDto finishForm = new();
    private InterventionDto? finishingIntervention;
    private bool isLoading = true;
    private bool showFinishDialog = false;
    private bool finishSuccessful = true;
    private DateTime? startDate;
    private TimeSpan? startTime;
    private DateTime? endDate;
    private TimeSpan? endTime;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            assignments = await Http.GetFromJsonAsync<List<WorkAssignmentDto>>(
                "api/workassignments/mine") ?? new();
            materials = await Http.GetFromJsonAsync<List<LookupDto>>(
                "api/lookups/materials") ?? new();
            materialUnits = await Http.GetFromJsonAsync<List<LookupDto>>(
                "api/lookups/material-units") ?? new();
        }
        catch { }
        finally { isLoading = false; }
    }

    private async Task StartIntervention(int assignmentId)
    {
        try
        {
            var dto = new InterventionCreateDto { WorkAssignmentId = assignmentId };
            var response = await Http.PostAsJsonAsync("api/interventions", dto);
            if (response.IsSuccessStatusCode)
                await LoadData();
        }
        catch { }
    }

    private void OpenFinishDialog(InterventionDto intervention, bool successful)
    {
        finishingIntervention = intervention;
        finishSuccessful = successful;
        finishForm = new InterventionFinishDto
        {
            Id = intervention.Id,
            IsSuccessful = successful
        };
        startDate = null;
        startTime = null;
        endDate = null;
        endTime = null;
        showFinishDialog = true;
    }

    private async Task FinishIntervention()
    {
        try
        {
            if (startDate.HasValue && startTime.HasValue)
                finishForm.StartedAt = startDate.Value.Date + startTime.Value;

            if (endDate.HasValue && endTime.HasValue)
                finishForm.FinishedAt = endDate.Value.Date + endTime.Value;

            var response = await Http.PutAsJsonAsync(
                $"api/interventions/{finishForm.Id}/finish", finishForm);
            if (response.IsSuccessStatusCode)
            {
                showFinishDialog = false;
                await LoadData();
            }
        }
        catch { }
    }


    private async Task AddMaterial(int interventionId)
    {
        try
        {
            materialForm.InterventionId = interventionId;
            var response = await Http.PostAsJsonAsync(
                $"api/interventions/{interventionId}/materials", materialForm);
            if (response.IsSuccessStatusCode)
            {
                materialForm = new InterventionMaterialCreateDto();
                await LoadData();
            }
        }
        catch { }
    }
}