@page "/fault-reports"
@inject HttpClient Http
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>Fault Reports - Reparo</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Fault Reports</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => Navigation.NavigateTo("/fault-reports/create"))">
        New Fault Report
    </MudButton>
</MudStack>

@if (!CurrentUser.HasAnyRole("Admin", "Manager"))
{
    <MudAlert Severity="Severity.Warning">Access denied.</MudAlert>
}
else
{
<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField @bind-Value="filter.SearchText"
                          Label="Search"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="int?"
                       @bind-Value="filter.FaultStatusId"
                       Label="Status"
                       Variant="Variant.Outlined"
                       Clearable="true">
                @foreach (var s in statuses)
                {
                    <MudSelectItem T="int?" Value="@((int?)s.Id)">@s.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="int?"
                       @bind-Value="filter.FaultPriorityId"
                       Label="Priority"
                       Variant="Variant.Outlined"
                       Clearable="true">
                @foreach (var p in priorities)
                {
                    <MudSelectItem T="int?" Value="@((int?)p.Id)">@p.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="int?"
                       @bind-Value="filter.LocationId"
                       Label="Location"
                       Variant="Variant.Outlined"
                       Clearable="true">
                @foreach (var l in locationLookup)
                {
                    <MudSelectItem T="int?" Value="@((int?)l.Id)">@l.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="int?"
                       @bind-Value="filter.FaultTypeId"
                       Label="Fault Type"
                       Variant="Variant.Outlined"
                       Clearable="true">
                @foreach (var t in faultTypes)
                {
                    <MudSelectItem T="int?" Value="@((int?)t.Id)">@t.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="string"
                       @bind-Value="sortBy"
                       Label="Sort By"
                       Variant="Variant.Outlined"
                       Clearable="true">
                <MudSelectItem T="string" Value="@("priority")">Priority</MudSelectItem>
                <MudSelectItem T="string" Value="@("deadline")">Deadline</MudSelectItem>
                <MudSelectItem T="string" Value="@("created")">Created</MudSelectItem>
                <MudSelectItem T="string" Value="@("status")">Status</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudDatePicker @bind-Date="dateFrom"
                           Label="Date From"
                           Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudDatePicker @bind-Date="dateTo"
                           Label="Date To"
                           Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4"
                 Class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="ApplyFilter">
                Apply
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       OnClick="ResetFilter">
                Reset
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (reports.Count == 0)
{
    <MudAlert Severity="Severity.Info">No fault reports found.</MudAlert>
}
else
{
    @if (AttentionReports.Any())
    {
        <MudPaper Class="pa-3 mb-4"
                  Style="border: 1px solid var(--mud-palette-warning); border-radius: 8px;">
            <MudTable Items="@AttentionReports"
                      Hover="true"
                      Dense="true"
                      T="FaultReportDto"
                      Elevation="0"
                      OnRowClick="@((TableRowClickEventArgs<FaultReportDto> args) => {
                          viewedReports.Add(args.Item.Id);
                          Navigation.NavigateTo($"/fault-reports/{args.Item.Id}");
                      })">
            <HeaderContent>
                <MudTh>Title</MudTh>
                <MudTh Class="hide-mobile">Location</MudTh>
                <MudTh Class="hide-mobile">Type</MudTh>
                <MudTh>Priority</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Class="hide-mobile">Assigned To</MudTh>
                <MudTh Class="hide-mobile">Deadline</MudTh>
                <MudTh Class="hide-mobile">Created</MudTh>
            </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            @if (context.HasActiveFailedIntervention)
                            {
                                <MudChip T="string"
                                         Color="Color.Error"
                                         Size="Size.Small"
                                         Icon="@Icons.Material.Filled.Warning">
                                    Failed
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string"
                                         Color="Color.Info"
                                         Size="Size.Small"
                                         Icon="@Icons.Material.Filled.FiberNew">
                                    New
                                </MudChip>
                            }
                            <MudText Typo="Typo.body2">@context.Title</MudText>
                        </MudStack>
                    </MudTd>
                    <MudTd Class="hide-mobile">@context.LocationName</MudTd>
                    <MudTd Class="hide-mobile">
                        @if (context.FaultPriorityName is not null)
                        {
                            <MudChip T="string"
                                     Color="@GetPriorityColor(context.FaultPriorityName)"
                                     Size="Size.Small">
                                @context.FaultPriorityName
                            </MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">-</MudText>
                        }
                    </MudTd>
                    <MudTd>
                        <MudChip T="string"
                                 Color="@GetStatusColor(context.FaultStatusName)"
                                 Size="Size.Small">
                            @context.FaultStatusName
                        </MudChip>
                    </MudTd>
                    <MudTd>@context.CreatedAt.ToString("dd.MM.yyyy HH:mm")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }

    <MudTable Items="@SortedReports"
              Hover="true"
              Striped="false"
              Dense="true"
              T="FaultReportDto"
              RowStyleFunc="@GetRowStyle"
            OnRowClick="@((TableRowClickEventArgs<FaultReportDto> args) => {
                viewedReports.Add(args.Item.Id);
                Navigation.NavigateTo($"/fault-reports/{args.Item.Id}");
            })">
        <HeaderContent>
            <MudTh>Title</MudTh>
            <MudTh>Location</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Priority</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Assigned To</MudTh>
            <MudTh>Deadline</MudTh>
            <MudTh>Created</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Title</MudTd>
            <MudTd>@context.LocationName</MudTd>
            <MudTd Class="hide-mobile">@(context.FaultTypeName ?? "-")</MudTd>
            <MudTd>
                @if (context.FaultPriorityName is not null &&
                     context.FaultStatusName != "Closed")
                {
                    <MudChip T="string"
                             Color="@GetPriorityColor(context.FaultPriorityName)"
                             Size="Size.Small">
                        @context.FaultPriorityName
                    </MudChip>
                }
                else
                {
                    <MudText Typo="Typo.body2">
                        @(context.FaultPriorityName ?? "-")
                    </MudText>
                }
            </MudTd>
            <MudTd>
                @if (context.FaultStatusName != "Closed")
                {
                    <MudChip T="string"
                             Color="@GetStatusColor(context.FaultStatusName)"
                             Size="Size.Small">
                        @context.FaultStatusName
                    </MudChip>
                }
                else
                {
                    <MudText Typo="Typo.body2"
                             Style="color: var(--mud-palette-text-disabled);">
                        @context.FaultStatusName
                    </MudText>
                }
            </MudTd>
            <MudTd>@(context.ActiveTechnicianName ?? "-")</MudTd>
            <MudTd>
                @if (context.Deadline.HasValue &&
                     context.Deadline < DateTime.UtcNow &&
                     context.FaultStatusName != "Closed" &&
                     context.FaultStatusName != "Resolved")
                {
                    <MudText Style="color: var(--mud-palette-error); font-weight: 600;">
                        @context.Deadline.Value.ToString("dd.MM.yyyy") ⚠
                    </MudText>
                }
                else
                {
                    @(context.Deadline?.ToString("dd.MM.yyyy") ?? "-")
                }
            </MudTd>
            <MudTd>@context.CreatedAt.ToString("dd.MM.yyyy")</MudTd>
        </RowTemplate>
    </MudTable>
}
}

@code {
    private List<FaultReportDto> reports = new();
    private List<LookupDto> statuses = new();
    private List<LookupDto> priorities = new();
    private List<LookupDto> locationLookup = new();
    private List<LookupDto> faultTypes = new();
    private List<LookupDto> employees = new();
    private FaultReportFilterDto filter = new();
    private bool isLoading = true;
    private HashSet<int> viewedReports = new();
    private DateTime? dateFrom;
    private string? sortBy;
    private DateTime? dateTo;

private IEnumerable<FaultReportDto> AttentionReports =>
    reports.Where(r =>
        (r.FaultStatusName == "Submitted" ||
         r.HasFailedIntervention) &&
        !viewedReports.Contains(r.Id))
    .OrderByDescending(r => r.CreatedAt);

    private IEnumerable<FaultReportDto> RegularReports =>
        reports.Where(r =>
            r.FaultStatusName != "Submitted" &&
            !r.HasFailedIntervention);

private IEnumerable<FaultReportDto> SortedReports => sortBy switch
{
    "priority" => reports
        .OrderBy(r => r.FaultStatusName == "Closed" ? 1 : 0)
        .ThenBy(r => GetPriorityOrder(r.FaultPriorityName)),
    "deadline" => reports
        .OrderBy(r => r.FaultStatusName == "Closed" ? 1 : 0)
        .ThenBy(r => r.Deadline.HasValue ? 0 : 1)
        .ThenBy(r => r.Deadline ?? DateTime.MaxValue),
    "created" => reports
        .OrderBy(r => r.FaultStatusName == "Closed" ? 1 : 0)
        .ThenByDescending(r => r.CreatedAt),
    "status" => reports
        .OrderBy(r => r.FaultStatusName == "Closed" ? 1 : 0)
        .ThenBy(r => r.FaultStatusName),
    _ => reports
        .OrderBy(r => r.FaultStatusName == "Closed" ? 1 : 0)
        .ThenBy(r => GetPriorityOrder(r.FaultPriorityName))
        .ThenBy(r => r.Deadline.HasValue ? 0 : 1)
        .ThenBy(r => r.Deadline ?? DateTime.MaxValue)
};

    private int GetPriorityOrder(string? priority) => priority switch
    {
        "Critical" => 0,
        "High" => 1,
        "Medium" => 2,
        "Low" => 3,
        _ => 4
    };

    private string GetRowStyle(FaultReportDto report, int index)
    {
        if (report.FaultStatusName == "Closed")
            return "opacity: 0.5; font-style: italic;";

        if (report.HasFailedIntervention)
            return "background-color: rgba(239, 68, 68, 0.08); border-left: 3px solid #ef4444;";

        return "";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await LoadReports();
    }

    private async Task LoadLookups()
    {
        try
        {
            var t1 = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/fault-statuses");
            var t2 = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/fault-priorities");
            var t3 = Http.GetFromJsonAsync<List<LookupDto>>("api/locations/lookup");
            var t4 = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/fault-types");
            var t5 = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/employees");

            await Task.WhenAll(t1, t2, t3, t4, t5);

            statuses = t1.Result ?? new();
            priorities = t2.Result ?? new();
            locationLookup = t3.Result ?? new();
            faultTypes = t4.Result ?? new();
            employees = t5.Result ?? new();
        }
        catch { }
    }

    private async Task LoadReports()
    {
        isLoading = true;
        try
        {
            var query = BuildQueryString();
            reports = await Http.GetFromJsonAsync<List<FaultReportDto>>(
                $"api/faultreports?{query}") ?? new();
        }
        catch { }
        finally { isLoading = false; }
    }

    private string BuildQueryString()
    {
        var parts = new List<string>();
        if (dateFrom.HasValue)
            parts.Add($"DateFrom={dateFrom.Value:yyyy-MM-dd}");
        if (dateTo.HasValue)
            parts.Add($"DateTo={dateTo.Value:yyyy-MM-dd}");
        if (!string.IsNullOrWhiteSpace(filter.SearchText))
            parts.Add($"SearchText={Uri.EscapeDataString(filter.SearchText)}");
        if (filter.LocationId.HasValue)
            parts.Add($"LocationId={filter.LocationId}");
        if (filter.FaultTypeId.HasValue)
            parts.Add($"FaultTypeId={filter.FaultTypeId}");
        if (filter.FaultPriorityId.HasValue)
            parts.Add($"FaultPriorityId={filter.FaultPriorityId}");
        if (filter.FaultStatusId.HasValue)
            parts.Add($"FaultStatusId={filter.FaultStatusId}");
        return string.Join("&", parts);
    }

    private async Task ApplyFilter() => await LoadReports();

    private async Task ResetFilter()
    {
        filter = new FaultReportFilterDto();
        dateFrom = null;
        dateTo = null;
        await LoadReports();
    }

    private Color GetPriorityColor(string? priority) => priority switch
    {
        "Critical" => Color.Error,
        "High" => Color.Warning,
        "Medium" => Color.Info,
        _ => Color.Default
    };

    private Color GetStatusColor(string? status) => status switch
    {
        "Closed" => Color.Success,
        "Resolved" => Color.Info,
        "In Progress" => Color.Warning,
        "Assigned" => Color.Secondary,
        "Reviewed" => Color.Primary,
        _ => Color.Default
    };
}