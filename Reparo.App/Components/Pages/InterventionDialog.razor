@inject HttpClient Http
@inject CurrentUserService CurrentUser

<MudDialogContent>
    @* Materijali *@
    <MudText Typo="Typo.subtitle2" Class="mb-2">Materials Used</MudText>
    @if (Intervention.Materials.Any())
    {
        @foreach (var mat in Intervention.Materials)
        {
            <MudText Typo="Typo.body2" Class="mb-1">
                • @mat.MaterialName — @mat.Quantity @mat.MaterialUnitName
            </MudText>
        }
    }
    else
    {
        <MudText Typo="Typo.body2"
                 Style="color: var(--mud-palette-text-secondary);"
                 Class="mb-2">
            No materials added yet.
        </MudText>
    }

    <MudDivider Class="my-3" />

    <MudText Typo="Typo.subtitle2" Class="mb-2">Add Material</MudText>
    <MudGrid>
        <MudItem xs="12" sm="5">
            <MudTextField @bind-Value="materialName"
                          Label="Material Name"
                          Variant="Variant.Outlined"
                          Placeholder="e.g. Cable 2.5mm" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudNumericField @bind-Value="materialQuantity"
                             Label="Qty"
                             Variant="Variant.Outlined"
                             Min="0.01m" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="int"
                       @bind-Value="materialUnitId"
                       Label="Unit"
                       Variant="Variant.Outlined">
                @foreach (var u in MaterialUnits)
                {
                    <MudSelectItem T="int" Value="@u.Id">@u.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Small"
                       OnClick="AddMaterial">
                Add
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@error</MudAlert>
    }

    <MudDivider Class="my-3" />

    <MudText Typo="Typo.subtitle2" Class="mb-2">Finish Intervention</MudText>
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudDatePicker @bind-Date="startDate"
                           Label="Start Date"
                           Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTimePicker @bind-Time="startTime"
                           Label="Start Time"
                           Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudDatePicker @bind-Date="endDate"
                           Label="End Date"
                           Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTimePicker @bind-Time="endTime"
                           Label="End Time"
                           Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField @bind-Value="finishNote"
                          Label="Note"
                          Variant="Variant.Outlined"
                          Lines="2"
                          HelperText="Required" />
        </MudItem>
    </MudGrid>
</MudDialogContent>

<MudDialogActions>
    <MudButton OnClick="Cancel">Close</MudButton>
    <MudButton Variant="Variant.Filled"
               Color="Color.Error"
               OnClick="@(() => Finish(false))">
        Mark as Failed
    </MudButton>
    <MudButton Variant="Variant.Filled"
               Color="Color.Success"
               OnClick="@(() => Finish(true))">
        Complete Successfully
    </MudButton>
</MudDialogActions>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public InterventionDto Intervention { get; set; } = null!;
    [Parameter] public List<LookupDto> MaterialUnits { get; set; } = new();
    [Parameter] public EventCallback OnMaterialAdded { get; set; }

    private string materialName = string.Empty;
    private decimal materialQuantity = 1;
    private int materialUnitId = 0;
    private DateTime? startDate = DateTime.Today;
    private TimeSpan? startTime;
    private DateTime? endDate = DateTime.Today;
    private TimeSpan? endTime;
    private string finishNote = string.Empty;
    private string? error;

    private async Task AddMaterial()
    {
        error = null;

        if (string.IsNullOrWhiteSpace(materialName))
        {
            error = "Material name is required.";
            return;
        }
        if (materialQuantity <= 0)
        {
            error = "Quantity must be greater than zero.";
            return;
        }
        if (materialUnitId == 0)
        {
            error = "Please select a unit.";
            return;
        }

        try
        {
            var materialsLookup = await Http.GetFromJsonAsync<List<LookupDto>>(
                "api/lookups/materials") ?? new();

            var existing = materialsLookup.FirstOrDefault(m =>
                m.Name.Equals(materialName, StringComparison.OrdinalIgnoreCase));

            int materialId;

            if (existing is not null)
            {
                materialId = existing.Id;
            }
            else
            {
                var createResponse = await Http.PostAsJsonAsync("api/materials",
                    new CreateMaterialDto { Name = materialName });

                if (!createResponse.IsSuccessStatusCode)
                {
                    error = "Error creating material.";
                    return;
                }

                var newMaterial = await createResponse.Content
                    .ReadFromJsonAsync<LookupDto>();
                materialId = newMaterial!.Id;
            }

            var dto = new InterventionMaterialCreateDto
            {
                InterventionId = Intervention.Id,
                MaterialId = materialId,
                Quantity = materialQuantity,
                MaterialUnitId = materialUnitId
            };

            var response = await Http.PostAsJsonAsync(
                $"api/interventions/{Intervention.Id}/materials", dto);

            if (response.IsSuccessStatusCode)
            {
                materialName = string.Empty;
                materialQuantity = 1;
                materialUnitId = 0;
                error = null;
                await OnMaterialAdded.InvokeAsync();
            }
            else
            {
                error = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
    }

    private async Task Finish(bool successful)
    {
        error = null;

        if (string.IsNullOrWhiteSpace(finishNote))
        {
            error = "Note is required.";
            return;
        }

        if (!startDate.HasValue || !startTime.HasValue ||
            !endDate.HasValue || !endTime.HasValue)
        {
            error = "Please enter start and end date/time.";
            return;
        }

        var startDateTime = startDate.Value.Date + startTime.Value;
        var endDateTime = endDate.Value.Date + endTime.Value;

        if (endDateTime <= startDateTime)
        {
            error = "End time must be after start time.";
            return;
        }

        var dto = new InterventionFinishDto
        {
            Id = Intervention.Id,
            StartedAt = startDateTime,
            FinishedAt = endDateTime,
            Note = finishNote,
            IsSuccessful = successful
        };

        var response = await Http.PutAsJsonAsync(
            $"api/interventions/{Intervention.Id}/finish", dto);

        if (response.IsSuccessStatusCode)
        {
            MudDialog.Close(DialogResult.Ok(successful));
        }
        else
        {
            error = await response.Content.ReadAsStringAsync();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
