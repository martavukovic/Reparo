@page "/my-assignments"
@inject HttpClient Http
@inject CurrentUserService CurrentUser
@inject IDialogService DialogService

<PageTitle>My Assignments - Reparo</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">My Assignments</MudText>

@if (!CurrentUser.HasAnyRole("Technician", "Admin"))
{
    <MudAlert Severity="Severity.Warning">Access denied.</MudAlert>
}
else if (isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (activeAssignments.Any())
    {
        <MudText Typo="Typo.h5" Class="mb-3">Active Assignments</MudText>

        @foreach (var assignment in activeAssignments)
        {
            <MudPaper Class="pa-4 mb-4" Style="border-left: 4px solid #7c4dff;">
                <MudGrid>
                    <MudItem xs="12" md="9">
                        <MudText Typo="Typo.h6" Class="mb-2">
                            @assignment.FaultReportTitle
                        </MudText>
                        <MudGrid>
                            <MudItem xs="6" sm="3">
                                <MudText Typo="Typo.caption">Location</MudText>
                                <MudText Typo="Typo.body2">@assignment.LocationName</MudText>
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudText Typo="Typo.caption">Fault Type</MudText>
                                <MudText Typo="Typo.body2">
                                    @(string.IsNullOrEmpty(assignment.FaultTypeName)
                                        ? "-" : assignment.FaultTypeName)
                                </MudText>
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudText Typo="Typo.caption">Priority</MudText>
                                <MudChip T="string"
                                         Color="@GetPriorityColor(assignment.FaultPriorityName)"
                                         Size="Size.Small">
                                    @(string.IsNullOrEmpty(assignment.FaultPriorityName)
                                        ? "-" : assignment.FaultPriorityName)
                                </MudChip>
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudText Typo="Typo.caption">Assigned</MudText>
                                <MudText Typo="Typo.body2">
                                    @assignment.AssignedAt.ToString("dd.MM.yyyy")
                                </MudText>
                            </MudItem>
                            @if (!string.IsNullOrWhiteSpace(assignment.Note))
                            {
                                <MudItem xs="12">
                                    <MudText Typo="Typo.caption">Note</MudText>
                                    <MudText Typo="Typo.body2">@assignment.Note</MudText>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudItem>

                    <MudItem xs="12" md="3" Class="d-flex align-center justify-end">
                        @if (GetPlannedIntervention(assignment) is null)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                       OnClick="@(() => StartIntervention(assignment.Id))">
                                Start Intervention
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.ArrowForward"
                                       OnClick="@(() => OpenFinishDialog(
                                                                                                                  GetPlannedIntervention(assignment)!,
                                                                                                                  assignment.FaultReportId))">
                                Continue Intervention
                            </MudButton>
                        }
                    </MudItem>
                </MudGrid>

                @if (GetFailedInterventions(assignment).Any())
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: red;">
                        Failed Interventions (@GetFailedInterventions(assignment).Count)
                    </MudText>
                    @foreach (var fi in GetFailedInterventions(assignment))
                    {
                        <MudPaper Class="pa-2 mb-1" Outlined="true">
                            <MudText Typo="Typo.body2">
                                @fi.CreatedAt.ToString("dd.MM.yyyy") —
                                @(fi.Note ?? "-")
                            </MudText>
                        </MudPaper>
                    }
                }

                @if (GetPlannedIntervention(assignment) is not null)
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Active Intervention</MudText>
                    <MudPaper Class="pa-3" Outlined="true">
                        @if (GetPlannedIntervention(assignment)!.Materials.Any())
                        {
                            <MudText Typo="Typo.subtitle2" Class="mb-1">
                                Materials Used
                            </MudText>
                            @foreach (var mat in GetPlannedIntervention(assignment)!.Materials)
                            {
                                <MudText Typo="Typo.body2" Class="mb-1">
                                    • @mat.MaterialName — @mat.Quantity @mat.MaterialUnitName
                                </MudText>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2"
                                     Style="color: var(--mud-palette-text-secondary);">
                                No materials added yet. Click "Continue Intervention" to add.
                            </MudText>
                        }

                        <AttachmentUpload FaultReportId="@assignment.FaultReportId"
                                          Attachments="@GetAttachments(assignment.FaultReportId)"
                                          FixedPurpose="Photo After Work"
                                          OnAttachmentChanged="LoadData" />
                    </MudPaper>
                }
            </MudPaper>
        }
    }
    else
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            No active assignments.
        </MudAlert>
    }

    @if (completedAssignments.Any())
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h5" Class="mb-3" Style="color: grey;">
            Completed Assignments
        </MudText>

        @foreach (var assignment in completedAssignments)
        {
            <MudPaper Class="pa-3 mb-3" Style="opacity: 0.7;">
                <MudText Typo="Typo.subtitle1">@assignment.FaultReportTitle</MudText>
                <MudText Typo="Typo.body2">
                    @assignment.LocationName —
                    @assignment.FaultStatusName —
                    @assignment.AssignedAt.ToString("dd.MM.yyyy")
                </MudText>
                @foreach (var intervention in assignment.Interventions
                                    .Where(i => i.InterventionStatusName == "Completed"))
                {
                    <MudText Typo="Typo.body2" Class="mt-1">
                        ✓ Completed: @intervention.FinishedAt?.ToString("dd.MM.yyyy HH:mm")
                        — @(intervention.Note ?? "-")
                    </MudText>
                    @foreach (var mat in intervention.Materials)
                    {
                        <MudText Typo="Typo.caption">
                            &nbsp;&nbsp;• @mat.MaterialName —
                            @mat.Quantity @mat.MaterialUnitName
                        </MudText>
                    }
                }
            </MudPaper>
        }
    }
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <MudAlert Severity="@messageSeverity" Class="mt-4"
              ShowCloseIcon="true"
              CloseIconClicked="@(() => message = null)">
        @message
    </MudAlert>
}

@code {
    private List<WorkAssignmentDto> assignments = new();
    private List<LookupDto> materialUnits = new();
    private Dictionary<int, List<AttachmentDto>> attachmentsByReport = new();
    private bool isLoading = true;
    private string? message;
    private Severity messageSeverity = Severity.Success;

    private IEnumerable<WorkAssignmentDto> activeAssignments =>
        assignments.Where(a => a.IsActive &&
            a.FaultStatusName != "Resolved" &&
            a.FaultStatusName != "Closed");

    private IEnumerable<WorkAssignmentDto> completedAssignments =>
        assignments.Where(a => !a.IsActive ||
            a.FaultStatusName == "Resolved" ||
            a.FaultStatusName == "Closed");

    private InterventionDto? GetPlannedIntervention(WorkAssignmentDto assignment) =>
        assignment.Interventions.FirstOrDefault(i =>
            i.InterventionStatusName == "Planned");

    private List<InterventionDto> GetFailedInterventions(WorkAssignmentDto assignment) =>
        assignment.Interventions
            .Where(i => i.InterventionStatusName == "Failed")
            .ToList();

    private List<AttachmentDto> GetAttachments(int faultReportId)
    {
        return attachmentsByReport.TryGetValue(faultReportId, out var list) ? list : new();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var t1 = Http.GetFromJsonAsync<List<WorkAssignmentDto>>(
                "api/workassignments/mine");
            var t2 = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/material-units");

            await Task.WhenAll(t1, t2);

            assignments = t1.Result ?? new();
            materialUnits = t2.Result ?? new();

            attachmentsByReport.Clear();
            foreach (var assignment in assignments)
            {
                try
                {
                    var atts = await Http.GetFromJsonAsync<List<AttachmentDto>>(
                        $"api/attachments/fault-report/{assignment.FaultReportId}") ?? new();
                    attachmentsByReport[assignment.FaultReportId] = atts;
                }
                catch { }
            }
        }
        catch { }
        finally { isLoading = false; }
    }

    private async Task StartIntervention(int assignmentId)
    {
        try
        {
            var dto = new InterventionCreateDto { WorkAssignmentId = assignmentId };
            var response = await Http.PostAsJsonAsync("api/interventions", dto);

            if (response.IsSuccessStatusCode)
            {
                message = "Intervention started.";
                messageSeverity = Severity.Success;
                await LoadData();
            }
            else
            {
                message = await response.Content.ReadAsStringAsync();
                messageSeverity = Severity.Error;
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            messageSeverity = Severity.Error;
        }
    }

    private async Task OpenFinishDialog(InterventionDto intervention, int faultReportId)
    {
        var title = assignments
            .FirstOrDefault(a => a.FaultReportId == faultReportId)
            ?.FaultReportTitle ?? "Intervention";

        var parameters = new DialogParameters
        {
            ["Intervention"] = intervention,
            ["MaterialUnits"] = materialUnits,
            ["OnMaterialAdded"] = EventCallback.Factory.Create(this, LoadData)
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<InterventionDialog>(
            title, parameters, options);

        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            var successful = result.Data is bool b && b;
            message = successful
                ? "Intervention completed. Report marked as Resolved."
                : "Intervention marked as failed. You can start a new one.";
            messageSeverity = successful ? Severity.Success : Severity.Warning;
            await LoadData();
        }
    }

    private Color GetPriorityColor(string? priority) => priority switch
    {
        "Critical" => Color.Error,
        "High" => Color.Warning,
        "Medium" => Color.Info,
        _ => Color.Default
    };

    private Color GetStatusColor(string? status) => status switch
    {
        "Closed" => Color.Success,
        "Resolved" => Color.Info,
        "In Progress" => Color.Warning,
        _ => Color.Default
    };
}