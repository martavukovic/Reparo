@using Reparo.App.Services
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation
@implements IDisposable

<MudNavMenu>
    @if (!CurrentUser.IsLoggedIn)
    {
        <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login">
            Prijava
        </MudNavLink>
    }
    else
    {
        <MudNavLink Href="/" Icon="@Icons.Material.Filled.Dashboard"
                    Match="NavLinkMatch.All">
            Dashboard
        </MudNavLink>

        @if (CurrentUser.HasAnyRole("Admin", "Manager"))
        {
            <MudNavLink Href="/locations" Icon="@Icons.Material.Filled.LocationOn">
                Lokacije
            </MudNavLink>

            <MudNavLink Href="/fault-reports" Icon="@Icons.Material.Filled.BugReport">
                Prijave kvarova
            </MudNavLink>

            <MudNavLink Href="/assignments" Icon="@Icons.Material.Filled.Assignment">
                Dodjele
            </MudNavLink>

            <MudNavLink Href="/interventions" Icon="@Icons.Material.Filled.Build">
                Intervencije
            </MudNavLink>
        }

        @if (CurrentUser.HasRole("Admin"))
        {
            <MudNavLink Href="/users" Icon="@Icons.Material.Filled.People">
                Korisnici
            </MudNavLink>
        }

        @if (CurrentUser.HasRole("Reporter"))
        {
            <MudNavLink Href="/my-reports" Icon="@Icons.Material.Filled.ListAlt">
                Moje prijave
            </MudNavLink>
        }

        @if (CurrentUser.HasRole("Technician"))
        {
            <MudNavLink Href="/my-assignments" Icon="@Icons.Material.Filled.Engineering">
                Moji nalozi
            </MudNavLink>
        }

        @if (CurrentUser.HasAnyRole("Admin", "Manager"))
        {
            <MudNavLink Href="/employees" Icon="@Icons.Material.Filled.Badge">
                Employees
            </MudNavLink>
        }

        <MudDivider Class="my-2" />

        <MudNavLink Icon="@Icons.Material.Filled.Logout"
                    OnClick="HandleLogout">
            Odjava
        </MudNavLink>
    }
</MudNavMenu>

@code {
    protected override void OnInitialized()
    {
        CurrentUser.UserChanged += HandleUserChanged;
    }

    private void HandleUserChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleLogout()
    {
        CurrentUser.Logout();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        CurrentUser.UserChanged -= HandleUserChanged;
    }
}